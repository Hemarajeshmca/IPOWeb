          $("#rshared_applied_price").val(item.shared_applied_price);
          $("#rremarks").val(item.rejected_reason); 
      }
 
    function get_rule_code() {
        var ipo_code =  localStorage.getItem("selectedIPO");
        $.ajax({
            type: "POST",
            url: '@Url.Action("Getrulecode", "Rejection")',
            data: {
                ipo_code: ipo_code
            },
            dataType: "json",
            success: function (response) {
                if (!response.success) {
                    console.log(response.message);
                    return;
                }
                //var data = response.data;
                var data = JSON.parse(response.data);
                $("#rrule_code").empty();
                // ✅ Default option
                $("#rrule_code").append(
                    $('<option>', {
                        value: '',
                        text: '-- Select --'
                    })
                );
                 
               $.each(data.Table, function (i, item) {
                $("#rrule_code").append(
                    $('<option>', {
                        value: item.rule_code,
                        text:  item.rule_name
                    })
                );
            });
                 
            },
            error: function (xhr) {
                console.log("Error:", xhr.responseText);
            }
        });
    }
</script>