          function addSave() {
           var isValid = true;
           var offer_code =  localStorage.getItem("selectedIPO");
            var ipo = offer_code;
            var appno = $('#appno').val();
            var orderno = $('#orderno').val();
            var panno = $('#panno').val();        
            var qty = $('#shares').val();
            var shares = $('#shared_applied_price').val();
            var amt = $('#amt').val();
            var rule_code =$('#rule_code').val().split('/').pop().trim();
             var remarks = $('#remarks').val();
              if(appno === "") {
                    $("#queryappno").text("Please Enter Appl. No");
                isValid = false;
                } else {
                    $("#queryappno").text("");
                }
               if(orderno === "") {
                    $("#queryorderno").text("Please Enter Order No.");
                isValid = false;
                } else {
                    $("#queryorderno").text("");
                }
               if(panno === "") {
                    $("#querypanno").text("Please Enter PAN No.");
                isValid = false;
                } else {
                    $("#querypanno").text("");
                }
                if(remarks === "") {
                    $("#queryremarks").text("Please Enter Remarks");
                isValid = false;
                } else {
                    $("#queryremarks").text("");
                }
            if (isValid) {
                var mymodel = {
                    ipo_code: ipo,
                    applno: appno,
                    orderno: orderno,
                    panno: panno,
                    qty: qty,
                    shares: shares,
                    amt: amt,
                    rule_code:rule_code,
                    addremarks: remarks,
                    rejremarks: ''
                  };
            try {
                  $.ajax({
                          type: "POST",
                          url: '@Url.Action("saveAddRejDetails", "Rejection")',
                          dataType: 'json',
                          data: JSON.stringify(mymodel),
                          contentType: 'application/json; charset=utf-8',
                          success: function (response) {
                              console.log(response);
                              var result = JSON.parse(response._data);
                                if (result.length > 0) {
                                      if (result[0].result == 1) {
                                               $.alert({
                                                  title: 'IPO Allotment',
                                                  //content: result[0].message,
                                                  content: "Added Sucessfully",
                                                  type: 'green',
                                                  buttons: {
                                                      ok: function () {
                                                          $('#additionsModal').modal('hide');
                                                             var offer_code =  localStorage.getItem("selectedIPO");
                                                            if(offer_code){
                                                                runrecon(false);
                                                            }
                                                        }
                                                  }
                                              });
                                      }
                                      else {
                                             $.alert({
                                                title: 'IPO Allotment',
                                                content:result[0].message,
                                                type: 'red',
                                            });
                                      }
                                  }
                          }
                  });
              } catch (e) {
                   console.log(e)
               }
            }
             
        }

