@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<!DOCTYPE html>
<html>  
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Run Rejection</title>
    <style>
        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            background-color: #027ed1 !important;
            color: #fff !important;
        }

        .nav-tabs .nav-item .nav-link:not(.active) {
            background-color: #716969;
            color: #fff;
        }

        /* Alternate row color */
        #rejectionList .k-grid-content tr.k-alt td {
            background-color: #fff;
            color: #000;
        }

        /* Consistent borders */
        #rejectionList .k-grid-header th,
        #rejectionList .k-grid-content td {
            border-right: 1px solid #ddd;
        }

        /* Remove last border */
        #rejectionList .k-grid-header th:last-child,
        #rejectionList .k-grid-content td:last-child {
            border-right: none;
        }

        /* Fixed layout for alignment */
        #rejectionList .k-grid-header table,
        #rejectionList .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #rejectionList .k-grid-header th,
        #rejectionList .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Compact size */
        #rejectionList .k-grid-content td {
            padding: 3px 6px;
            font-size: 12px;
            line-height: 18px;
            background:#fff;
        }

        #rejectionList .k-grid-header th {
            padding: 4px 6px;
            font-size: 12px;
            line-height: 18px;
        }

        /* Compact row height */
        #rejectionList .k-grid-content tr {
            height: 26px;
        }

        #rejectionList .k-grid-header tr {
            height: 28px;
        }

        .k-grid td { 
            padding: 2px 2px;
            font-size:13px;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body" style="margin-top:5px;height: 556px;width: 103%;margin-left: -18px;">
                <div class="row" style="margin-top:-17px;">
                    <div class="col-sm-3">
                        <label class="form-label" for="ctype" data-field="ctype">IPO Name</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <input type="text" class="form-control" id="iponame" readonly />
                    </div>
                   @*  <div class="col-sm-2">
                        <button type="button" class="btn btn-primary" id="btnSave" onclick="runrecon(true)" style="padding: 3px 25px;margin-top:28px;">Run Rejection</button>
                    </div>
                    <div class="col-sm-2">
                        <button type="button" onclick="exportSummary()" class="btn btn-primary" id="btnGen" style="padding: 3px 25px;margin-top:28px;">Export Summary </button>
                    </div>
                    <div class="col-sm-2">
                        <button type="button" onclick="exportdetailSummary()" class="btn btn-primary" id="btnGen" style="padding: 3px 25px;margin-top:28px; white-space: nowrap;">Export Detail Summary </button>
                    </div> *@
                    <div class="col-sm-9">
                        <span>
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="runrecon(true)" style="padding: 3px 25px;margin-top:28px;">Run Rejection</button>
                            &nbsp;&nbsp;
                            <button type="button" onclick="exportSummary()" class="btn btn-primary" id="btnGen" style="padding: 3px 25px;margin-top:28px;">Export Summary </button>
                            &nbsp;&nbsp;
                            <button type="button" onclick="exportdetailSummary()" class="btn btn-primary" id="btnGensummary" style="padding: 3px 25px;margin-top:28px; white-space: nowrap;">Export Detail Summary </button>
                        </span>
                    </div>
                </div>
               <div class="row" style="margin-top:20px;">
                    <div class="col-sm-12">
                        <div id="rejectionList"></div>
                    </div>
                   </div>
               </div>
            </div>
        </div>  
   
</body>

</html>
<script>
    var selectedCodes = [];
         $(document).ready(function () {
            $('#navhead').text('Run Rejection');
            var ipoName = localStorage.getItem("selectedIPOText");
            $("#iponame").val(ipoName);
            $("#rejectionList").hide(); 
            var offer_code =  localStorage.getItem("selectedIPO");
            if(offer_code){
                runrecon(false);
            }
        });

       function runrecon(runRule) {       
         var offer_code =  localStorage.getItem("selectedIPO");
          try {
            customAjax({
                type: "GET",
                url: '@Url.Action("getRejReason", "Rejection")',
                data: {
                offer_code: offer_code,
                runRule : runRule
                },
                success: function (response) {
                    if (response && response.success) {
                      var data = JSON.parse(response.data);
                      fetchrejgrid(data);
                    }
                    else {
                        $.alert({
                            title: 'IPO Allotment',
                            content: 'Save failed!',
                            type: 'red',
                        });
                    }
                },
                error: function (er) {
                    console.log(er);
                }
            });
        } catch (e) {
            console.log(e);
        }
    }


     function fetchrejgrid(data){
         $("#rejectionList").show();
        var columns =  [
            {
                title: "Select",
                width: 45,
                locked: true,
                headerAttributes: { style: "text-align:center;" },
                attributes: { style: "text-align:center;" },
                headerTemplate:
                    "<div style='text-align:center;'>" +
                    "<input type='checkbox' id='selectAll' /> " +
                    "<label for='selectAll' style='cursor:pointer;'>All</label>" +
                    "</div>",
                template: "<input type='checkbox' class='client-checkbox' value='#= rule_name #' />"
            },
             {
             field: "rule_code",
             title: "Rule Code",
             locked: true,
             hidden: true,
         },
            {
                field: "rule_name",
                title: "Reject Reason",
                width: 260,
                locked: true,
                footerTemplate: "<div style='font-weight:bold;text-align:center;'>TOTAL</div>"
            },
            {
                title: "Original Rejections",
                headerAttributes: { style: "text-align:center;font-weight:bold;" },
                columns: [
                        { field: "original_appl_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" }, 
                        { field: "original_qty_count", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" }, 
                        { field: "original_total_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>"
    },
                ]
            },

            {
                title: "Additions",
                headerAttributes: { style: "text-align:center;font-weight:bold;" },
                columns: [
                        { field: "additions_appl_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" }, 
                        { field: "additions_qty_count", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;"} , footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" },
                        { field: "additions_total_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>"
    },
                ]
            },

             {
                title: "Rejections",
                headerAttributes: { style: "text-align:center;font-weight:bold;" },
                columns: [
                        { field: "rejections_appl_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" }, 
                        { field: "rejections_qty_count", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" }, 
                        { field: "rejections_total_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;"}, footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>"
    },
                ]
            },

            {
                title: "Final Rejections",
                headerAttributes: { style: "text-align:center;font-weight:bold;" },
                columns: [
                    { field: "total_app_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;color:red;"},footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" },
                    { field: "total_qty_amount", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;color:red;"},footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" },
                    { field: "total_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;color:red;"},footerTemplate: "<div style='text-align:right;font-weight:bold'>" + "#= kendo.toString(sum, 'n0') #" + "</div>" }
                ]
            }
        ];
                 if ($("#rejectionList").data("kendoGrid")) {
                    $("#rejectionList").data("kendoGrid").destroy();
                    $("#rejectionList").empty();                    
                 }
                     $("#rejectionList").kendoGrid({
                     dataSource: {
                         data: data,
                         pageSize: 20,
                         aggregate: [
                            { field: "original_appl_count", aggregate: "sum" },
                            { field: "original_qty_count", aggregate: "sum" },
                            { field: "original_total_amount", aggregate: "sum" },

                            { field: "additions_appl_count", aggregate: "sum" },
                            { field: "additions_qty_count", aggregate: "sum" },
                            { field: "additions_total_amount", aggregate: "sum" },

                            { field: "rejections_appl_count", aggregate: "sum" },
                            { field: "rejections_qty_count", aggregate: "sum" },
                            { field: "rejections_total_amount", aggregate: "sum" },

                            { field: "total_app_count", aggregate: "sum" },
                            { field: "total_qty_amount", aggregate: "sum" },
                            { field: "total_amount", aggregate: "sum" }
                        ]
                     },
                     height: 410,
                     pageable: {
                         pageSizes: [10, 20, 30],
                         refresh: true
                     },
                     sortable: true,
                     filterable: true,
                     resizable: true,
                     columns: columns,
                      excel: {
                        fileName: "Rejection_Summary_Report.xlsx",
                        allPages: true,
                        filterable: true
                       },
                     dataBound: function () {
                        var grid = this;
                        grid.tbody.find("tr").each(function () {
                            var dataItem = grid.dataItem(this);
                            if (selectedCodes.includes(dataItem.rule_code)) {
                                $(this).find(".client-checkbox").prop("checked", true);
                            }
                        });
                     }
                 });
    }
    
     $(document).on("click", "#selectAll", function () {
        var isChecked = this.checked;

        $(".client-checkbox").each(function () {
            $(this).prop("checked", isChecked);
        });
    });

     $(document).on("change", "#selectAll", function () {
        var grid = $("#rejectionList").data("kendoGrid");

        if (this.checked) {
            var allData = grid.dataSource.data();
            selectedCodes = allData.map(function (item) {
             return item.rule_code;
            });
        } else {
            selectedCodes = [];
        }
        grid.tbody.find(".client-checkbox").prop("checked", this.checked);
    });

    $(document).on("change", ".client-checkbox", function () {
        var grid = $("#rejectionList").data("kendoGrid");
        var row = $(this).closest("tr");
        var dataItem = grid.dataItem(row);
        var code = dataItem.rule_code;

        if ($(this).is(":checked")) {
            if (!selectedCodes.includes(code)) {
                selectedCodes.push(code);
            }
        } else {
            selectedCodes = selectedCodes.filter(x => x !== code);
        }

        console.log("Selected:", selectedCodes);
    });

    function exportSummary() {
        var grid = $("#rejectionList").data("kendoGrid");
        grid.saveAsExcel();
    }

    function exportdetailSummary_old() {

        // if (selectedCodes.length === 0) {
        //     $.alert({
        //         title: 'IPO Web',
        //         content: "Please select at least one bank",
        //         type: 'red',
        //     });
        //     return;
        // }
        // var rule_code = selectedCodes.join(",");
        // var offer_code = localStorage.getItem("selectedIPO");
        // var url = '/Rejection/getdetailRejectionSummary'
        //     + '?offer_code=' + encodeURIComponent(offer_code)
        //     + '&rule_code=' + encodeURIComponent(rule_code);

        // window.location.href = url;
    }

    function exportdetailSummary() {

        if (selectedCodes.length === 0) {
            $.alert({
                title: 'IPO Web',
                content: "Please select at least one Reason",
                type: 'red',
            });
            return;
        }
        var rule_code = selectedCodes.join(",");
        var offer_code = localStorage.getItem("selectedIPO");
        var url = '/Rejection/getdetailRejectionSummary'
            + '?offer_code=' + encodeURIComponent(offer_code)
            + '&rule_code=' + encodeURIComponent(rule_code);

        window.location.href = url;
    }
</script>