    function exportdetailSummary() {

        if (selectedCodes.length === 0) {
            $.alert({
                title: 'IPO Web',
                content: "Please select at least one Reason",
                type: 'red',
            });
            return;
        }
        var rule_code = selectedCodes.join(",");
        var offer_code = localStorage.getItem("selectedIPO");
        var url = '/Rejection/getdetailRejectionSummary'
            + '?offer_code=' + encodeURIComponent(offer_code)
            + '&rule_code=' + encodeURIComponent(rule_code);

        window.location.href = url;
        selectedCodes = [];
    }

    $(document).ready(function () {
        get_rule_code();
    });
