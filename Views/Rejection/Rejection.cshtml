    function loadaddrejlist(offer_code) {       
        try {
           $.ajax({
                type: "GET",
                url: '@Url.Action("GetAddRejList", "Rejection")',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: {
                    ipo_code: offer_code
                },
                    success: function (response) {
                    console.log(response);
                    var result = JSON.parse(response.data);
                    var applList = result.Table;
                    var rejectionList = result.Table1;
                    console.log(result.Table);
                     console.log(result.Table1);
                     if (result.Table.length > 0) {
                            $("#ipo").val(offer_code);
                                  $("#appno").autocomplete({
                                        appendTo: "#additionsModal",
                                        minLength: 3,
                                        source: function (request, response) {
                                            var matches = $.grep(applList, function (item) {
                                                return item.appl_no.toLowerCase()
                                                    .indexOf(request.term.toLowerCase()) >= 0;
                                            });
                                            response($.map(matches.slice(0, 20), function (item) {
                                                return {
                                                    label: item.appl_no,
                                                    value: item.appl_no,
                                                    appl_no: item.appl_no,
                                                    order_no: item.order_no,
                                                    pan_no: item.pan_no,
                                                    quantity:item.quantity,
                                                    shared_applied_price:item.shared_applied_price,
                                                    total_amount:item.total_amount,
                                                    rule_code:item.rule_code,
                                                    rejected_reason:item.rejected_reason,
