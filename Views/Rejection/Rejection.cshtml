<!DOCTYPE html>
<html>  
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Run Rejection</title>
    <style>
        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            background-color: #027ed1 !important;
            color: #fff !important;
        }

        .nav-tabs .nav-item .nav-link:not(.active) {
            background-color: #716969;
            color: #fff;
        }

        /* Alternate row color */
        #rejectionList .k-grid-content tr.k-alt td {
            background-color: #fff;
            color: #000;
        }

        /* Consistent borders */
        #rejectionList .k-grid-header th,
        #rejectionList .k-grid-content td {
            border-right: 1px solid #ddd;
        }

        /* Remove last border */
        #rejectionList .k-grid-header th:last-child,
        #rejectionList .k-grid-content td:last-child {
            border-right: none;
        }

        /* Fixed layout for alignment */
        #rejectionList .k-grid-header table,
        #rejectionList .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #rejectionList .k-grid-header th,
        #rejectionList .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Compact size */
        #rejectionList .k-grid-content td {
            padding: 3px 6px;
            font-size: 12px;
            line-height: 18px;
            background:#fff;
        }

        #rejectionList .k-grid-header th {
            padding: 4px 6px;
            font-size: 12px;
            line-height: 18px;
        }

        /* Compact row height */
        #rejectionList .k-grid-content tr {
            height: 26px;
        }

        #rejectionList .k-grid-header tr {
            height: 28px;
        }

        .k-grid td { 
            padding: 2px 2px;
            font-size:13px;
        }

        .ui-autocomplete {
            max-height: 250px;
            overflow-y: auto;
            overflow-x: hidden;
            font-size:13px;
        }

        #spinner {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.3);
            z-index: 99999 !important;
        }

            #spinner img,
            #spinner .spinner-border {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }
    </style>
</head>

