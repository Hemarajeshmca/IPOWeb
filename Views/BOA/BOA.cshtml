@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    var userName = Context.Session.GetString("user_name");
    var role_code = Context.Session.GetString("user_role");
    var userCode = Context.Session.GetString("user_code");
    var menuJson = Context.Session.GetString("UserMenus");
    var menus = new List<MenuModel>();

    if (!string.IsNullOrEmpty(menuJson))
    {
        menus = System.Text.Json.JsonSerializer.Deserialize<List<MenuModel>>(menuJson);
    }

    var currentPath = Context.Request.Path.Value.ToLower();
    var normalizedPath = currentPath.Trim('/').ToLower();

    var currentMenu = menus?.FirstOrDefault(x =>
        (x.menu_url ?? "")
            .Replace("../", "")
            .Trim('/')
            .ToLower() == normalizedPath
    );
    var menuId = currentMenu?.menu_id;
    var addPerm = currentMenu?.add_perm;
    var modPerm = currentMenu?.mod_perm;
    var viewPerm = currentMenu?.view_perm;
    var delPerm = currentMenu?.delete_perm;
    var Boachecklist = currentMenu?.Boachecklist_perm;
}
