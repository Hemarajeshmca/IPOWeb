@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Basis of Allotments</title>
    <style>

        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            background-color: #027ed1 !important;
            color: #fff !important;
        }

        .nav-tabs .nav-item .nav-link:not(.active) {
            background-color: #716969;
            color: #fff;
        }

        .form-label{
            background-color: #fff;
            border: none;
            padding-left: 0px;
        }

        .main-container {
            width: 95%;
            margin: 20px auto;
            padding: 20px;
        }

        .header {
            font-weight: bold;
            margin-bottom: 15px;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 12px;
            align-items: center;
        }

        .col {
            display: flex;
            flex-direction: column;
            min-width: 150px;
        }

            .col.small {
                width: 100px;
            }

        input {
            height: 26px;
            padding: 3px;
            border: 1px solid #999;
            background: #fff;
        }

        .long-input {
            width: 70%;
        }

        .radio-group {
            margin-left: auto;
        }

        .section-box {
            border: 1px solid #2c7a7b;
            padding: 10px;
            margin-top: 10px;
        }

        .section-title {
            font-weight: bold;
            margin-bottom: 8px;
        }

        .button-row {
            text-align: center;
            margin-top: 20px;
        }

        button {
            padding: 6px 20px;
            margin: 0 10px;
            border: none;
            background: #ddd;
            cursor: pointer;
        }

            button:hover {
                background: #bbb;
            }

        .sign-section {
            margin-top: 20px;
        }

        .sign-row {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .sign-label {
            width: 120px;
            font-weight: 600;
        }

        .sign-box {
            width: 30%;
            padding: 0 10px;
        }

        .sign-title {
            text-align: center;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .sign-box input {
            width: 100%;
            height: 26px;
        }

        .radio-container {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .radio-item {
            display: flex;
            align-items: center;
            gap: 5px;
            margin: 0;
        }

        h5#navhead {
            position: relative;
            right: 340px;
            width: 30%;
        }

        .col-md-2-4 {
            flex: 0 0 auto;
            width: 16%;
        }

        .form-check {
            margin-bottom: 0;
        }
    </style>

</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body" style="margin-top:5px;height: 556px;width: 103%;margin-left: -18px;">
                <!-- File Path -->
                <div class="row">
                    <div class="col-md-2-4">

                        <input type="hidden" id="ipocode" />
                        <input type="hidden" id="clientid" />
                        <label class="form-label">Listing</label><br />
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="exchange" id="nse" value="NSE">
                            <label class="form-check-label" for="nse">NSE</label>
                        </div>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="exchange" id="bse" value="BSE" checked>
                            <label class="form-check-label" for="bse">BSE</label>
                        </div>

                    </div>
                    <div class="col-md-2-4">
                        <label class="form-label">Opening Date</label>
                        <input type="date" class="form-control" id="offer_openingdate" readonly />
                    </div>
                    <div class="col-md-2-4">
                        <label class="form-label">Closing Date</label>
                        <input type="date" class="form-control" id="offer_closingdate" readonly />
                    </div>
                    <div class="col-md-2-4">
                        <label class="form-label">Final Prospectus Date</label>
                        <input type="date" class="form-control" id="offer_listingdate" readonly />
                    </div>
                    <div class="col-md-2-4">
                        <label class="form-label">CIN NO</label>
                        <input type="text" class="form-control" id="client_cin" readonly />
                    </div>
                    <div class="col-md-2-4">
                        <label class="form-label">ISIN NO</label>
                        <input type="text" class="form-control" id="offer_isin" readonly />
                    </div>
                </div>

                <!-- Company Info -->
                <div class="row">
                    <div class="col">
                        <label class="form-label">Face Value</label>
                        <input type="number" class="form-control" id="offer_facevalue" readonly />
                    </div>

                    <div class="col">
                        <label class="form-label">As Price</label>
                        <input type="number" class="form-control" id="asprice" readonly />
                    </div>

                    <div class="col">
                        <label class="form-label">Premium</label>
                        <input type="number" class="form-control" id="offer_premiun" readonly />
                    </div>

                    <div class="col">
                        <label class="form-label">Lot Size</label>
                        <input type="number" class="form-control" id="offer_lotsize" readonly />
                    </div>

                    <div class="col">
                        <label class="form-label">Pre Issue Size</label>
                        <input type="number" class="form-control" id="offer_precapital" readonly />
                    </div>

                    <div class="col">
                        <label class="form-label">Current Issue Size</label>
                        <input type="number" class="form-control" id="offer_issuesize" readonly />
                    </div>

                </div>

                <!-- Issue Details -->

                <div class="row">
                    <div class="col-md-2-4">
                        <label class="form-label">Post Issue</label>
                        <input type="number" class="form-control" id="offer_postcapital" readonly />
                    </div>

                    <div class="col-md-2-4">
                        <label class="form-label">Market Maker Shares</label>
                        <input type="number" class="form-control" id="mm" readonly />
                    </div>

                    <div class="col-md-2-4">
                        <label class="form-label">QIB Shares</label>
                        <input type="number" class="form-control" value="1017000" readonly />
                    </div>

                    <div class="col-md-2-4">
                        <label class="form-label">Emp. Shares</label>
                        <input type="number" class="form-control" id="offer_empdiscount" readonly />
                    </div>

                    <div class="col-md-2-4">
                        <label class="form-label">Net Issue of Shares</label>
                        <input type="number" class="form-control" value="5102000" readonly />
                    </div>
                </div>
                <!-- Net Quantum -->
                <div class="section-box">
                    <div class="section-title">Net quantum available for allotment</div>

                    <div class="row">
                        <div class="col">
                            <label class="form-label">Spill over from Retail to Non-Retail</label>
                            <input type="number" class="form-control" value="0" readonly />
                        </div>

                        <div class="col">
                            <label class="form-label">Retail - Net quantum available</label>
                            <input type="number" class="form-control" value="1786000" readonly />
                        </div>

                        <div class="col">
                            <label class="form-label">Non-Retail <= 100000</label>
                            <input type="number" class="form-control" value="2871000" readonly />
                        </div>

                        <div class="col">
                            <label class="form-label">Non-Retail > 100000</label>
                            <input type="number" class="form-control" value="516000" readonly />
                        </div>
                    </div>
                </div>

                <!-- Signatories -->
                <div class="sign-section">

                    <!-- Name Row -->
                    <div class="sign-row">
                        <div class="sign-label">Name</div>

                        <div class="sign-box">
                            <div class="sign-title">Seren Capital Private Limited</div>
                            <input type="text" class="form-control" value="MR. AKUN GOYAL" readonly />
                        </div>

                        <div class="sign-box">
                            <div class="sign-title">Msafe Equipments Limited</div>
                            <input type="text" class="form-control" value="MS. RENUKA UNIYAL" readonly />
                        </div>

                        <div class="sign-box">
                            <div class="sign-title">Maashita Securities Pvt. Limited</div>
                            <input type="text" class="form-control" value="MR. MUKUL AGRAWAL" readonly />
                        </div>
                    </div>

                    <!-- Designation Row -->
                    <div class="sign-row">
                        <div class="sign-label">Designation</div>

                        <div class="sign-box">
                            <input type="text" class="form-control" value="AUTHORISED SIGNATORY" readonly />
                        </div>

                        <div class="sign-box">
                            <input type="text" class="form-control" value="COMPANY SECRETARY & COMPLIANCE" readonly />
                        </div>

                        <div class="sign-box">
                            <input type="text" class="form-control" value="DIRECTOR" readonly />
                        </div>
                    </div>
                    <!-- Buttons -->
                    <div class="button-row">
                        <button class="btn btn-primary" style="padding: 3px 25px;margin-bottom:20px;" id="generateBtn" onclick="generateReport()">Generate</button>
                        <button class="btn btn-primary" style="border-color: red;background-color: red; border-radius: 5px;color: white;margin-bottom: 30px;margin-bottom: 20px;padding: 3px 25px;" id="exitBtn">
                            Exit
                        </button>
                    </div>
            </div>
             </div>
         </div>
    </body>

</html>

 <script>     
    $( document ).ready(function() {             
             $('#navhead').text('Basics of Allotment');       
             var ipocode = localStorage.getItem("selectedIPO");
             var clientid = localStorage.getItem("selectedClientId");
             $("#ipocode").val(ipocode);
             $("#clientid").val(clientid);
            fetchIssuesetup();
    });


    function fetchIssuesetup(){         
            var offer_code = $("#ipocode").val();
            var client_code = $("#clientid").val();
            
            try {
            $.ajax({
                type: "GET",
                url: '@Url.Action("OfferFetch", "IssueSetup")',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: {
                    client_code:client_code,
                    offer_code:  offer_code
                },
                success: function (response) {
                        if (response && response.success == true ) {
                        var data = JSON.parse(response.data);
                        offerHeader = data.Table;                        
                        offerDetails = data.Table1;                       
                        offerBank = data.Table2;
                        offerStackHolder = data.Table3;
                        offerCategory = data.Table4;
                        offerMillstone = data.Table5;
                         var client_cin = offerHeader[0].client_cin;
                        $('#client_cin').val(client_cin);
                        var offer_isin = offerHeader[0].offer_isin;
                        $('#offer_isin').val(offer_isin);
                        var facevalue = offerDetails[0].offer_facevalue;
                         $('#offer_facevalue').val(facevalue);
                        var premium = offerDetails[0].offer_premiun;
                         $('#offer_premiun').val(premium);
                         var offersize = offerDetails[0].offer_issuesize;
                         $('#offer_issuesize').val(offersize);
                          var lotsize = offerDetails[0].offer_lotsize;
                         $('#offer_lotsize').val(lotsize);
                         var diff = offerDetails[0].offer_fixedprice -  offerDetails[0].offer_facevalue;
                         $('#asprice').val(diff);
                          var precapital = offerDetails[0].offer_precapital;
                         $('#offer_precapital').val(precapital);
                         var postcapital = offerDetails[0].offer_postcapital;
                         $('#offer_postcapital').val(postcapital);
                         var empshares = offerHeader[0].offer_empdiscount;
                         $('#offer_empdiscount').val(empshares);
                         var opendate = offerMillstone[0].offer_openingdate;
                         var formattedDate = new Date(opendate).toISOString().split('T')[0];
                        $('#offer_openingdate').val(formattedDate);
                         var closedate = offerMillstone[0].offer_closingdate;
                         var formattedCDate = new Date(closedate).toISOString().split('T')[0];
                        $('#offer_closingdate').val(formattedCDate);
                         var listdate = offerMillstone[0].offer_listingdate;
                         var formattedLDate = new Date(listdate).toISOString().split('T')[0];
                        $('#offer_listingdate').val(formattedLDate);
                        }
                    else {
                    }
                },
                error: function (er) {
                    alert(er)
                    console.log(er)
                }
            });
        }
            catch (e) {
                console.log(e)
            }
        }

    function generateReport() {
         var offer_code = localStorage.getItem("selectedIPO");
         if (!offer_code) {
            $.alert({
                title: 'IPO Web',
                content: "Please select IPO Name",
                type: 'red',
            });
            return;
        }
          try {
            customAjax({
                type: "GET",
                url: '@Url.Action("getMomReports", "BOA")',
                data: {
                offer_code: offer_code
                },
                    success: function (response) {
                        if (response && response.success) {
                            var data = response.data;
                            console.log("Datasets :", data);
                            var details = data.table1;
                            var row = details[0];
                            var bank = data.table2;
                            var table3 = data.table3;
                            var table4 = data.table4;
                            var table5 = data.table5;
                            var table6 = data.table6;
                            table6 = (table6 || []).map(x => ({
                            ...x,
                            times_subs: x.times_subs ? Number(x.times_subs) : 0
                        }));
                         var table7 = data.table7;
                          table7 = (table7 || []).map(x => ({
                            ...x,
                            times_subs: x.times_subs ? Number(x.times_subs) : 0
                        }));
                         var table8 = data.table8;
                          table8 = (table8 || []).map(x => ({
                            ...x,
                            times_subs: x.times_subs ? Number(x.times_subs) : 0
                        }));
                         var table9 = data.table9;
                          table9 = (table9 || []).map(x => ({
                            ...x,
                            times_subs: x.times_subs ? Number(x.times_subs) : 0
                        }));
                        var table10 = data.table10;
                            table10 = (table10 || []).map(x => ({
                            bank_name: x.bank_name || "",  // ✅ handle null
                            no_of_bids: Number(x.no_of_bids) || 0,
                            no_of_shares_applied: Number(x.no_of_shares_applied) || 0,
                            total_amount: Number(x.total_amount) || 0
                        }));
                         var table11 = data.table11;
                            cin = row.client_cin;
                            $('#cin').val(row.client_cin);
                                   fetch('@Url.Action("generateReport", "BOA")', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json'
                                            },
                                            body: JSON.stringify({
                                                summary: row,
                                                bankData: bank,
                                                nonasbabankData: table3,
                                                rejectionData: table4,
                                                categoryData: table5,
                                                categoryINDData: table6,
                                                categoryCo: table7,
                                                categoryNRA10L: table8,
                                                categoryNRB10L: table9,
                                                bankUPIData: table10,
                                                bidApplRcd: table11[0]
                                            })
                                        })
                                        .then(response => {
                                            if (!response.ok) {
                                                throw new Error("File download failed");
                                            }
                                            return response.blob();
                                        })
                                        .then(blob => {
                                            const url = window.URL.createObjectURL(blob);
                                            const a = document.createElement('a');
                                            a.href = url;
                                            a.download = "MOM_Report.docx";
                                            document.body.appendChild(a);
                                            a.click();
                                            a.remove();
                                            window.URL.revokeObjectURL(url);
                                        })
                                        .catch(error => {
                                            console.error("Download failed:", error);
                                        });
                                                var url = '/BOA/getboareport'
                                    + '?offer_code=' + encodeURIComponent(offer_code);
                                window.location.href = url;
                        }
                        else {
                        $.alert({
                            title: 'IPO Allotment',
                            content: 'Save failed!',
                            type: 'red',
                        });
                    }
                },
                error: function (er) {
                    console.log(er);
                }
            });
        } catch (e) {
            console.log(e);
        }

    }
    </script>