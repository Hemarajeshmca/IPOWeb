            function generateReport() {
               
        var offer_code = localStorage.getItem("selectedIPO");
        if (!offer_code) {
            $.alert({
                title: 'IPO Web',
                content: 'Please select IPO Name',
                type: 'red'
            });
            return;
        }
        showProgress();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GenerateBOAReport", "BOA")',
            data: JSON.stringify({
                offer_code: offer_code,
                user_code: '@userCode'
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (response) {

                hideProgress();

                if (response.success) {

                    $.alert({
                        title: 'IPO',
                        content: 'Report generation initiated. Please check Job Status in Utility.',
                        type: 'green'
                    });
                }
                else {

                    $.alert({
                        title: 'IPO',
                        content: response.message,
                        type: 'red'
                    });
                }
            },
            error: function () {

                hideProgress();

                $.alert({
                    title: 'IPO',
                    content: 'Unable to initiate report generation.',
                    type: 'red'
                });
            }
        });
    }
    
