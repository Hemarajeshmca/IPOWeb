            function validateCategoryTotal() {

        var issuesize = parseFloat($("#issuesize").val().replace(/,/g, '')) || 0;

        var grid = $("#offerCategoryGrid").data("kendoGrid");
        if (!grid) return false;

        var data = grid.dataSource.view();

        var total = 0;
        var isINDValid = false;

        data.forEach(function (item) {

            var shares = parseFloat(item.offer_cat_shares) || 0;

            total += shares;

            // IND category validation
            if (item.category_code === "IND" && shares > 0) {
                isINDValid = true;
            }
        });

        // Validate issue size total
        if (issuesize !== total) {
            $.alert({
                title: 'IPO Web',
                content: "Category Total ₹ (" + total + ") must match with Issue Size Total ₹ (" + issuesize + ")",
                type: 'red',
            });
            return false;
        }

        // Validate IND category mandatory
        if (!isINDValid) {
            $.alert({
                title: 'IPO Web',
                content: "IND category is mandatory and shares should be greater than 0.",
                type: 'red',
            });
            return false;
        }

        return true;
    }

     function formatIndianNumber(x) {
                if (x == null) return "";

                var parts = x.toFixed(2).split(".");
                var number = parts[0];
                var decimal = parts[1];

                var lastThree = number.substring(number.length - 3);
                var otherNumbers = number.substring(0, number.length - 3);

                if (otherNumbers !== "") {
                    lastThree = "," + lastThree;
                }

                var result = otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + lastThree;

                return result + "." + decimal;
            }

            function numericEditor(container, options) {
                $('<input data-bind="value:' + options.field + '" />')
                    .appendTo(container)
                    .kendoNumericTextBox({
                        min: 0,
                        format: "n2"
                    });
                container.find("input").css("text-align", "left");
            }

