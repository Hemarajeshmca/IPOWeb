    function boachecklist(data){       
    if ($("#checklistGrid").data("kendoGrid")) {
        $("#checklistGrid").data("kendoGrid").destroy();
        $("#checklistGrid").empty();
    }

    $("#checklistGrid").kendoGrid({
        dataSource: data,
        scrollable: true,
        height: 210,
        sortable: false,
        pageable: false,
        columns: [
            {
                field: "process_name",
                title: "Verification Page",
                width: 300,
            },
                {
                    title: "Verified",
                    width: 120,
                    attributes: {
                        style: "text-align:center;"
                    },
                    template:
                        "<input type='radio' disabled class='status-radio' name='status_#=id#' value='Verified' #= status == 'Verified' ? 'checked' : '' # />"
                },
                {
                    title: "Not Verified",
                    width: 120,
                    attributes: {
                        style: "text-align:center;"
                    },
                    template:
                            "<input type='radio' class='status-radio' " +
                            "name='status_#=id#' " +
                            "value='NotVerified' " +
                            "#= status == 'NotVerified' ? 'checked' : '' # " +
                            "#= status == 'Verified' ? 'disabled' : '' # />"
                }
        ]
    });
        validateApproveButton();
        $("#checklistModal").modal("show");
    }

    function approveVerification() {
        var results = [];
        $("#checklistGrid tbody tr").each(function () {
            var grid = $("#checklistGrid").data("kendoGrid");
            var dataItem = grid.dataItem(this);
            var status = $(this)
                .find("input[type='radio']:checked")
                .val();
            results.push({
                process_name: dataItem.process_name,
                status: status
            });
        });
        var remarks = $("#txtRemarks").val();
        offerHeaderSave('Y', remarks);
        $("#checklistModal").modal("hide");
    }

        $(document).on("change", ".status-radio", function () {
             console.log("Changed");
    console.log($(this).val());
        var grid = $("#checklistGrid").data("kendoGrid");
        var row = $(this).closest("tr");
        var dataItem = grid.dataItem(row);

        dataItem.set("status", $(this).val());

        validateApproveButton();
    });

    function validateApproveButton() {

        var grid = $("#checklistGrid").data("kendoGrid");
        var data = grid.dataSource.data();

        var allVerified = data.every(function(item) {
            return item.status === "Verified";
        });

        $("#btnApprove").prop("disabled", !allVerified);
    }


