                    model: {
                        id: "category_gid",
                        fields: {
                            category_gid: { editable: false },
                            offer_cat_code: { editable: false },
                            offer_cat_name: { editable: false },
                            offer_cat_shares: { type: "number", editable: true }
                        }
                    }
                },
               change: function (e) {
                if (e.field === "offer_cat_shares") {                   
                    var grid = $("#offerCategoryGrid").data("kendoGrid");
                    grid.refresh();
                }
            }
            },
            scrollable: {
                 height: 150
            },
            pageable: false,
            sortable: true,
            filterable: true,
            resizable: true,
            editable: "incell",
            columns: columns,
            dataBound: function () {
                $("#selectAll").off("click").on("click", function () {
                    $(".rowCheckbox").prop("checked", this.checked);
                });
                $(".rowCheckbox").off("click").on("click", function () {
                    if (!this.checked) {
                    } else {
                        var allChecked = $(".rowCheckbox").length === $(".rowCheckbox:checked").length;
                        $("#selectAll").prop("checked", allChecked);
                    }
                });
            }
        });
    }

        function formatIndianNumber(x) {
            if (x == null) return "";

            var parts = x.toFixed(2).split(".");
            var number = parts[0];
            var decimal = parts[1];

            var lastThree = number.substring(number.length - 3);
            var otherNumbers = number.substring(0, number.length - 3);

            if (otherNumbers !== "") {
                lastThree = "," + lastThree;
            }

            var result = otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + lastThree;

            return result + "." + decimal;
        }

        function numericEditor(container, options) {
            $('<input data-bind="value:' + options.field + '" />')
                .appendTo(container)
                .kendoNumericTextBox({
                    min: 0,
                    format: "n2"
                });
            container.find("input").css("text-align", "left");
        }

        function saveofferCategory() {
            if (!validateOfferAndClient()) {
                return;
            }
            var grid = $("#offerCategoryGrid").data("kendoGrid");
            var selectedData = [];
            $("#offerCategoryGrid tbody tr").each(function () {
                var checkbox = $(this).find(".rowCheckbox");
                if (checkbox.is(":checked")) {
                    var dataItem = grid.dataItem(this);
                    selectedData.push({
                        category_gid: dataItem.category_gid,
                        offer_cat_code: dataItem.offer_cat_code,
                        offer_cat_name: dataItem.offer_cat_name,
                        offer_cat_shares: dataItem.offer_cat_shares
                    });
                }
            });
            var isValid = true;
            if (!isValid) return;
            var payload = {};
            payload.json_data = JSON.stringify(selectedData);
            payload.offer_code = $("#offer_code").val();
            payload.client_code = $("#clientcode").val();
            payload.user_code = '@userName';
            payload.action = "INSERT";
            try {
                customAjax({
                    type: "POST",
                    url: '@Url.Action("saveCategory", "IssueSetup")',
                    data: JSON.stringify(payload),
                    success: function (response) {
                        if (response && response.success) {
                            var data = JSON.parse(response.data);
                            fetchIssuesetup();
                            $.alert({
                                title: 'IPO Allotment',
                                content: data[0].out_msg,
                                type: 'green',
                            });
                        }
                        else {
                            $.alert({
                                title: 'IPO Allotment',
                                content: 'Save failed!',
                                type: 'red',
                            });
                        }
                    }
                });
            } catch (e) {
                console.log(e);
        }
     }
    
