    function loadCatagory() {
        var mymodel = {
            in_master_code: "QCD_CATEGORY",
            in_user_code: ""
        };
        customAjax({
            type: "POST",
            url: '@Url.Action("OfferType", "IssueSetup")',
            data: JSON.stringify(mymodel),
            success: function (response) {
                var result = JSON.parse(response.data);
                var formattedData = result.map(function (item) {
                return {
                    category_gid: item.master_gid,
                    catagory_code: item.master_code,
                    catagory_name: item.master_name,
                    offer_cat_shares: 0
                };
            });
            fetchofferCategory(formattedData);
            },
            error: function (xhr) {
                console.log("Dropdown load error:", xhr.responseText);
            }
        });
    }

        function fetchofferCategory(data) {
            data.forEach(function (item) {
            if (item.offer_cat_shares) {
                item.offer_cat_shares = parseFloat(
                    item.offer_cat_shares.toString().replace(/,/g, "")
                );
            }
        });
        var columns = [
            {
                headerTemplate: `<input type="checkbox" id="selectAll" checked  />`,
                width: 70,
                template: `<input type="checkbox" class="rowCheckbox" checked />`,
                editable: false,
                hidden: true
            },
            {
                field: "category_gid",
                title: "ID",
                hidden: true
            },
            {
                field: "category_code",
                title: "Cat Code"
            },
            {
                field: "category_name",
                title: "Category Name"
            },
            {
                field: "offer_cat_shares",
                title: "Share",
                editor: numericEditor,
                attributes: {
                    style: "text-align: right;"
                },
                template: function (dataItem) {
                    return formatIndianNumber(dataItem.offer_cat_shares);
                },
                footerTemplate: function (data) {
                    var sum = data.offer_cat_shares ? data.offer_cat_shares.sum : 0;
                    return "Total: " + formatIndianNumber(sum);
                }
            }
        ];
        var grid = $("#offerCategoryGrid").data("kendoGrid");
        if (grid) {
            grid.destroy();
            $("#offerCategoryGrid").empty();
        }

        $("#offerCategoryGrid").kendoGrid({
            dataSource: {
                data: data,
                pageSize: 10,
                aggregate: [
                    { field: "offer_cat_shares", aggregate: "sum" }
                ],
