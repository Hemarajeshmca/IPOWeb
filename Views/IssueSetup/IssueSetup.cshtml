function getclientlist(){
        var mymodel = {
            p_client_gid: 0,
            p_action: "A"
        };
        try {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetClientList", "Dashboard")',
                dataType: 'json',
                data: JSON.stringify(mymodel),
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    if (response ) {
                     var clientList = JSON.parse(response._data);
                     $("#clientname").autocomplete({
                        source: $.map(clientList, function (item) {
                            return {
                                label: item.client_name, 
                                value: item.client_name, 
                                id: item.client_code       
                            };
                        }),
                        select: function (event, ui) {
                            $("#clientname").val(ui.item.value); 
                            $("#clientcode").val(ui.item.id);      
                            return false;
                        }
                    });
                    }
                    else {

                    }
                },
                error: function (er) {
                    alert(er)
                    console.log(er)
                }
            });
        }
            catch (e) {
                console.log(e)
            }
}

 function offerHeaderSave() {
     var isValid = true;
      if($("#clientcode").val() === "") { $("#v_clientcode").text("Please Choose Client Code"); isValid = false; }
      if($("#offer_type").val() === "") { $("#v_offer_type").text("Please Choose Offer Type");isValid = false;}
      if($("#listing").val() === "") { $("#v_listing").text("Please Choose Listing");isValid = false; }
      if($("#isin").val() === "") { $("#v_isin").text("Please Enter ISIN"); isValid = false; }
      if($("#status").val() === "") { $("#v_status").text("Please Choose status");isValid = false; }
      if(($("#remarks").val() === "I" || $("#status").val() === "C") && $("#remarks").val() === "") { $("#v_remarks").text("Please Enter Remark"); isValid = false;}
      if (isValid) { 
        var payload = {};
        payload.offer_header_gid = $("#offer_header_gid").val();
        payload.offer_code = $("#offer_header_gid").val() == 0 ? "" : $("#offer_code").val();
        payload.offer_type = $("#offer_type").val();
        payload.offer_listing_no = $("#listing").val();
        payload.offer_isin = $("#isin").val();
        payload.offer_status = $("#status").val();
        payload.offer_remarks = $("#remarks").val();
        payload.client_code = $("#clientcode").val();
        payload.user_code = '@userName';
        payload.active_status = 'Y';
        payload.action = $("#offer_header_gid").val() == 0 ? "INSERT": "UPDATE";
        payload.delete_flag = 'N';
        try {
        $.ajax({
            type: "POST",
            url: '@Url.Action("OfferHeaderSave", "IssueSetup")',
            dataType: 'json',
            data: JSON.stringify(payload),
            contentType: 'application/json; charset=utf-8',
