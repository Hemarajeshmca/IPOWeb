<script>
  $( document ).ready(function() {
          $('#navhead').text('Issue Setup');
          $('#offer_header_gid').val(0);
          $("#offer_detail_gid").val(0);
          $("#banker_gid").val(0);
          $("#stack_gid").val(0);
          $("#milestone_gid").val(0);
          $("#createedit").val($('#offer_header_gid').val() == 0 ? "CREATE": "EDIT");
          var offer_code = sessionStorage.getItem("edit_offer_code");
          var client_code = sessionStorage.getItem("edit_client_code");
          $("#clientcode").val(client_code);
          $("#offer_code").val(offer_code);                      
          loadMasterDropdown("QCD_MAST_OFFER_TYPE", "offer_type");
          loadMasterDropdown("QCD_MAST_LISTING", "listing");
          loadMasterDropdown("QCD_STATUS", "status");
          loadMasterDropdown("QCD_PRICE_TYPE", "pricetype");
          loadMasterDropdown("QCD_BANK_TYPE", "banktype");
          loadMasterDropdown("QCD_MAST_STATE", "state");
          loadMasterDropdown("QCD_MAST_STATE", "sh_state");
          loadMasterDropdown("QCD_STACK_HOLDER_TYPE", "sh_type");
          getclientlist();
          if(offer_code && client_code) {
              fetchIssuesetup(); 
          }
          $("#status").change(function () {
            var selectedValue = $(this).val();
            if (selectedValue === "I") {
                $("#remarks").prop("readonly", false);
            } else {
                $("#remarks").prop("readonly", true);
            }
          });
    });
    
    // Global variables

    offerHeader = "";
    offerDetails = "";
    offerBank = "";
    offerStackHolder = "";
    offerCategory = "";
    offerMillstone = "";
    activeOfferStatus = false;
    
    // $("#selectAll").on("change", function () {
    //     $(".rowCheckbox").prop("checked", $(this).prop("checked"));
    // });

    // // If one checkbox is unchecked → uncheck Select All
    // $(".rowCheckbox").on("change", function () {
    //     if (!$(this).prop("checked")) {
    //         $("#selectAll").prop("checked", false);
    //     }
    //     else if ($(".rowCheckbox:checked").length === $(".rowCheckbox").length) {
    //         $("#selectAll").prop("checked", true);
    //     }
    // });

    $("#pricetype").change(function () {
        var value = $(this).val();
        if (value == "F") {  
            $("#fprice").prop("disabled", false);
            $("#minprice").prop("disabled", true).val("");
            $("#maxprice").prop("disabled", true).val("");
            $("#cutoffprice").prop("disabled", true).val("");

        } else if (value == "P") {  
            $("#minprice").prop("disabled", false);
            $("#fprice").prop("disabled", true).val("");
             $("#maxprice").prop("disabled", false);
            $("#cutoffprice").prop("disabled", false);

        } else {  
            $("#fprice").prop("disabled", true).val("");
            $("#minprice").prop("disabled", true).val("");
        }      
    });

//  $('button[data-bs-target="#navs-top-bank"]').on('shown.bs.tab', function () {
