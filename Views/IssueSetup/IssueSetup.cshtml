    function setPostPrice(){
        var preCaptital = parseFloat($("#preissue").val()) || 0;
        var offer_issuesize = parseFloat($("#issuesize").val()) || 0;
        var postprice = preCaptital + offer_issuesize;
        $("#postissue").val(postprice.toFixed(2));
    }

    function validatePrices() {
        var min = parseFloat($("#minprice").val()) || 0;
        var max = parseFloat($("#maxprice").val()) || 0;
        var cutoff = parseFloat($("#cutoffprice").val()) || 0;
        var isValid = true;
        if (max <= min) {
            $.alert({
                title: 'IPO Web',
                content: "Maximum Price should be greater than Minimum Price",
                type: 'green',
            });
            isValid = false;
        }
        if (cutoff < min || cutoff > max) {
            $.alert({
                title: 'IPO Web',
                content: "Cut Off Price should be between Minimum and Maximum Price",
                type: 'green',
            });
            isValid = false;
        }
        return isValid;
    }

