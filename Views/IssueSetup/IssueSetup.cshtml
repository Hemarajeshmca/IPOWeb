            $("#icd").val(formatDate(data.offer_closingdate));
            $("#alotdate").val(formatDate(data.offer_allotmentdate));
            $("#apdate").val(formatDate(data.apdate));
            $("#ldate").val(formatDate(data.offer_listingdate));
            $("#nsdldate").val(formatDate(data.offer_nsdldate));
            $("#cdsldate").val(formatDate(data.offer_cdsldate));
            $("#refunddate").val(formatDate(data.offer_refunddate));
         }

        function formatDate(date) {
            return date ? date.split("T")[0] : "";
        }

    function saveOfferMilstone() {
        if (!validateOfferAndClient()) {
            return; 
        }
        var isValid = true;
        if (!isValid) return;
        var payload = {};
        payload.milestone_gid = parseInt($("#milestone_gid").val()) == 0 ? parseInt($("#milestone_gid").val()) : 0;
        payload.offer_openingdate = $("#iod").val();
        payload.offer_closingdate = $("#icd").val();
        payload.offer_allotmentdate = $("#alotdate").val();
        payload.offer_approvaldate = $("#apdate").val();
        payload.offer_listingdate = $("#ldate").val();
        payload.offer_nsdldate = $("#nsdldate").val();
        payload.offer_cdsldate = $("#cdsldate").val();
        payload.offer_refunddate = $("#refunddate").val();
        payload.offer_code = $("#offer_code").val();
        payload.client_code = $("#clientcode").val();
        payload.user_code = '@userName';
        payload.action = parseInt($("#milestone_gid").val()) == 0 ? "INSERT" : "UPDATE";
        try {
            customAjax({
                type: "POST",
                url: '@Url.Action("saveOfferMilstone", "IssueSetup")', 
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.success) {
                        var data = JSON.parse(response.data);
                        $("#milestone_gid").val(data[0].in_milestone_gid);
                        fetchIssuesetup();
                        $.alert({
                            title: 'IPO Allotment',
                            content: data[0].out_msg,
                            type: 'green',
                        });
                    }
                    else {
                        $.alert({
                            title: 'IPO Allotment',
                            content: 'Save failed!',
                            type: 'red',
                        });
                    }
                }
            });
        } catch (e) {
            console.log(e);
        }
    }

    // ================Common Methods ===============

        function validateOfferAndClient() {
            var status = $("#status").val();
            var offerCode = $("#offer_code").val();
            var clientCode = $("#clientcode").val();

        if (status == "I" && activeofferstatus == true) {

            if (!offerCode) {
                $.alert({
                    title: 'Validation',
                    content: 'Offer Code is required!',
                    type: 'red'
                });
                return false;
            }

            if (!clientCode) {
                $.alert({
                    title: 'Validation',
                    content: 'Client Code is required!',
                    type: 'red'
                });
                return false;
            }

            return true; 
        }

        else if (status == "I" && activeofferstatus == false) {
            $.alert({
                title: 'Validation',
                content: 'Status Need to be in Draft Mode until fill the mandatory fields .!',
                type: 'red'
            });
            return false;
        }

        return true; 
    }
    
</script>