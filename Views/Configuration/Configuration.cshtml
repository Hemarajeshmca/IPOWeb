            width: 23%;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body" style="margin-top:5px;height: 550px;width: 103%;margin-left: -18px;box-shadow: 0px 6px 7px -1px rgba(67, 89, 113, 0.12);">
              <div class="row">
                    <div class="col-xl-12">                        
                        <div class="nav-align-top mb-4">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item">
                                    <button type="button"
                                            class="nav-link active"
                                            role="tab"
                                            data-bs-toggle="tab"
                                            data-bs-target="#navs-top-home"
                                            aria-controls="navs-top-home"
                                            aria-selected="true">
                                        Configuration Details
                                    </button>
                                </li>                                
                            </ul>
                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="navs-top-home" role="tabpanel" style="margin-top: -34px;">
                                    <div class="accordion mt-3" id="accordionExample">
                                        <div class="card accordion-item active">
                                            <h2 class="accordion-header" id="headingOne">
                                                <button type="button"
                                                        class="accordion-button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#accordionOne"
                                                        aria-expanded="true"
                                                        aria-controls="accordionOne">
                                                   Password Policy
                                                </button>
                                            </h2>
                                            <div id="accordionOne"
                                                 class="accordion-collapse collapse show">
                                                <div class="accordion-body">
                                                    <div class="row">                                                        
                                                        <div class="col-sm-2">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Min. Password Length</label>
                                                            <input type="text" id="password_min_len" class="form-control">
                                                        </div>
                                                        <div class="col-sm-2">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Max. Password Length</label>
                                                            <input type="text" id="password_max_len" class="form-control">
                                                        </div>
                                                        <div class="col-sm-2 radio-group" style="position: relative;left: 20px;">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Req. Uppercase</label><br />
                                                            <label>
                                                                <input type="radio" name="pwd_require_uppercase" value="Y">
                                                                Yes
                                                            </label>
                                                            <label>
                                                                <input type="radio" name="pwd_require_uppercase" value="N">
                                                                No
                                                            </label>
                                                        </div>
                                                        <div class="col-sm-2 radio-group">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Req. Lowercase</label><br />
                                                            <label>
                                                                <input type="radio" name="pwd_require_lowercase" value="Y">
                                                                Yes
                                                            </label>
                                                            <label>
                                                                <input type="radio" name="pwd_require_lowercase" value="N">
                                                                No
                                                            </label>
                                                        </div>
                                                        <div class="col-sm-2 radio-group">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Req. Number</label><br />
                                                            <label>
                                                                <input type="radio" name="pwd_require_number" value="Y">
                                                                Yes
                                                            </label>
                                                            <label>
                                                                <input type="radio" name="pwd_require_number" value="N">
                                                                No
                                                            </label>
                                                        </div>
                                                        <div class="col-sm-2 radio-group">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Req. Spl. Character</label><br />
                                                            <label>
                                                                <input type="radio" name="pwd_require_special_char" value="Y">
                                                                Yes
                                                            </label>
                                                            <label>
                                                                <input type="radio" name="pwd_require_special_char" value="N">
                                                                No
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="row" style="margin-top:10px;">
                                                        <div class="col-sm-2">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Password History Count</label>
                                                            <input type="text" id="pwd_history_count" class="form-control">
                                                        </div>
                                                        <div class="col-sm-2">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Max. Failed Login Attempts</label>
                                                            <input type="text" id="password_attempt_count" class="form-control">
                                                        </div>
                                                        <div class="col-sm-2" style="position: relative;left: 20px;">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Lock Duration Mins.</label>
                                                            <input type="text" id="pwd_lockout_duration_minutes" class="form-control">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card accordion-item">
                                            <h2 class="accordion-header" id="headingTwo">
                                                <button type="button"
                                                        class="accordion-button collapsed"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#accordionTwo"
                                                        aria-expanded="true"
                                                        aria-controls="accordionTwo">
                                                   Session Settings
                                                </button>
                                            </h2>
                                            <div id="accordionTwo"
                                                 class="accordion-collapse collapse show"
                                                 aria-labelledby="headingTwo">
                                                <div class="accordion-body">
                                                    <div class="row">                                                       
                                                        <div class="col-sm-2">
                                                            <label class="form-label" for="ReferredBy" data-field="ReferredBy">Session Timeout (Min)</label>
                                                            <select id="timeout" class="form-select">
                                                                <option value="20">20</option>
                                                                <option value = "30">30</option>
                                                                <option value="45">45</option>
                                                                <option value="60">60</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>                                        
                                    </div>                                    
                                </div>                         
                          
                            </div>
                        </div>
                    </div>
              </div>      
               <div class="row">
                   <div class="col-sm-4">

                   </div>
                    <div class="col-sm-4">
                        <center><button type="button" class="btn btn-primary" id="btnSave" onclick="savepwdpolicy()" style="padding: 3px 25px;margin-top:28px;width:40%">Save</button></center>
                   </div>
                    <div class="col-sm-4">
                    </div>
               </div>
                
            </div>
        </div>
    </div>      
   
</body>

</html>

<script type="text/javascript">
    $( document ).ready(function() {
        fetchdata();
    });

    function fetchdata() {
         $.ajax({
             type: "POST",
            url: '@Url.Action("GetConfigList", "Configuration")',
            dataType: "json",
             contentType: 'application/json; charset=utf-8',
             success: function (data) {
                 console.log("CONFDATA:", data);
                 var configList = JSON.parse(data.data);
                 var configRow = configList[0];
                 var passwordConfig = JSON.parse(configRow.password_config);
                 console.log("CRES : ", passwordConfig);
                 var requireUpper = passwordConfig.pwd_require_uppercase;
                 var requireLower = passwordConfig.pwd_require_lowercase;
                  var requireNumber = passwordConfig.pwd_require_number;   
                  var requireSplChar = passwordConfig.pwd_require_special_char;
                  var sessionTimeout = passwordConfig.screen_session_timeout;

                 $("#password_min_len").val(passwordConfig.password_min_len);
                 $("#password_max_len").val(passwordConfig.password_max_len);
                  $("input[name='pwd_require_uppercase'][value='" + requireUpper + "']") .prop("checked", true);
                  $("input[name='pwd_require_lowercase'][value='" + requireLower + "']") .prop("checked", true);
                 $("input[name='pwd_require_number'][value='" + requireNumber + "']") .prop("checked", true);
                 $("input[name='pwd_require_special_char'][value='" + requireSplChar + "']") .prop("checked", true);
                 $("#pwd_history_count").val(passwordConfig.pwd_history_count);
                 $("#password_attempt_count").val(passwordConfig.password_attempt_count);
                 $("#pwd_lockout_duration_minutes").val(passwordConfig.pwd_lockout_duration_minutes);                    
                 $("#timeout").val(sessionTimeout);
             }
         });
    }

    function savepwdpolicy() {
     var requestData = {
        user_id: "@userName",
        password_max_len: $("#password_max_len").val(),
        password_min_len: $("#password_min_len").val(),
        password_attempt_count: $("#password_attempt_count").val(),

        pwd_require_uppercase: $("input[name='pwd_require_uppercase']:checked").val(),
        pwd_require_lowercase: $("input[name='pwd_require_lowercase']:checked").val(),
        pwd_require_number: $("input[name='pwd_require_number']:checked").val(),
        pwd_require_special_char: $("input[name='pwd_require_special_char']:checked").val(),

        pwd_history_count: $("#pwd_history_count").val(),
        pwd_lockout_duration_minutes: $("#pwd_lockout_duration_minutes").val(),
        screen_session_timeout: $("#timeout").val()
    };

    console.log("UPDATE DATA:", requestData);
    console.log("UPDATE JSON:", JSON.stringify(requestData));
               $.ajax({
                    url: '@Url.Action("UpdateConfig", "Configuration")',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify(requestData),

                    success: function (response) {
                        console.log("UPDATE RESPONSE:", response);
                        if (response.success && response.data) {
                            var resultData = JSON.parse(response.data);
                            if (resultData.length > 0) {
                                var message = resultData[0].result;
                                    $.dialog({
                                            title: 'Success',
                                            content: message,
                                            type: 'green',                                           
                                        });
                            }
                        }
                    },

                    error: function (xhr, status, error) {
                        console.log("ERROR:", error);
                        console.log("RESPONSE:", xhr.responseText);
                    }
                });
    }

</script>