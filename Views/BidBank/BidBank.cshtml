@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<!DOCTYPE html>
<html>  
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Run Recon - Bid Vs Bank</title>
    <style>
        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            background-color: #027ed1 !important;
            color: #fff !important;
        }

        .nav-tabs .nav-item .nav-link:not(.active) {
            background-color: #716969;
            color: #fff;
        }

        /* Alternate row color */
        #banktList .k-grid-content tr.k-alt td {
            background-color: #fff;
            color: #000;
        }

        /* Consistent borders */
        #banktList .k-grid-header th,
        #banktList .k-grid-content td {
            border-right: 1px solid #ddd;
        }

            /* Remove last border */
            #banktList .k-grid-header th:last-child,
            #banktList .k-grid-content td:last-child {
                border-right: none;
            }

        /* Fixed layout for alignment */
        #banktList .k-grid-header table,
        #banktList .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #banktList .k-grid-header th,
        #banktList .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Compact size */
        #banktList .k-grid-content td {
            padding: 3px 6px;
            font-size: 12px;
            line-height: 18px;
            background: #fff;
        }

        #banktList .k-grid-header th {
            padding: 4px 6px;
            font-size: 12px;
            line-height: 18px;
        }

        /* Compact row height */
        #banktList .k-grid-content tr {
            height: 26px;
        }

        #banktList .k-grid-header tr {
            height: 28px;
        }

        .k-grid td {
            padding: 2px 2px;
            font-size: 13px;
        }

        #banktList { 
            margin-top:-12px;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body" style="margin-top:5px;height: 556px;width: 103%;margin-left: -18px;">
                <div class="row" style="margin-top: -17px;">
                    <div class="col-sm-3">
                        <label class="form-label" for="ctype" data-field="ctype">IPO Name</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <input type="text" class="form-control" id="iponame" readonly />
                        <input type="text" class="form-control" id="ipocode" hidden />
                    </div>
                    <div class="col-sm-9">
                        <span>
                        <button type="button" class="btn btn-primary" id="btnSave" onclick="runrecon()" style="padding: 3px 25px;margin-top:28px;">Run Recon</button>
                        &nbsp;&nbsp;
                        <button type="button" onclick="exportSummary()" class="btn btn-primary" id="btnGen" style="padding: 3px 25px;margin-top:28px;">Export Summary </button>
                        &nbsp;&nbsp;
                        <button type="button" onclick="exportdetailSummary()" class="btn btn-primary" id="btnGen" style="padding: 3px 25px;margin-top:28px; white-space: nowrap;">Export Detail Summary </button>
                        </span>
                    </div>
                    
                </div>
               <div class="row" style="margin-top:20px;">
                    <div class="col-sm-12">
                        <div id="banktList"></div>
                    </div>
                    </div>             
                   </div>
               </div>
            </div>  
        
   
</body>

</html>
<script>
    var selectedCodes = [];
      $(document).ready(function () {
          getBidBank();
        $('#navhead').text('Bid Vs Bank');
        var ipoName = localStorage.getItem("selectedIPOText");
        var ipocode = localStorage.getItem("selectedIPO");
        $("#iponame").val(ipoName);
        $("#ipocode").val(ipocode);
    });

    function runrecon() {
        getBidBank();
    }

    $(document).on("click", "#selectAll", function () {
        var isChecked = this.checked;

        $(".client-checkbox").each(function () {
            $(this).prop("checked", isChecked);
        });
    });

     $(document).on("change", "#selectAll", function () {
        var grid = $("#banktList").data("kendoGrid");

        if (this.checked) {
            var allData = grid.dataSource.data();
            selectedCodes = allData.map(function (item) {
             return item.bnk_code;
            });
        } else {
            selectedCodes = [];
        }
        grid.tbody.find(".client-checkbox").prop("checked", this.checked);
    });

    $(document).on("change", ".client-checkbox", function () {
        var grid = $("#banktList").data("kendoGrid");
        var row = $(this).closest("tr");
        var dataItem = grid.dataItem(row);
        var code = dataItem.bnk_code;

        if ($(this).is(":checked")) {
            if (!selectedCodes.includes(code)) {
                selectedCodes.push(code);
            }
        } else {
            selectedCodes = selectedCodes.filter(x => x !== code);
        }

        console.log("Selected:", selectedCodes);
    });

    function getBidBank(){
        var offer_code =  localStorage.getItem("selectedIPO");
          try {
            customAjax({
                type: "GET",
                url: '@Url.Action("getBidBank", "BidBank")',
                data: {
                offer_code: offer_code
                },
                success: function (response) {
                    if (response && response.success) {
                      var data = JSON.parse(response.data);
                      fetchgrid(data);
                    }
                    else {
                        $.alert({
                            title: 'IPO Allotment',
                            content: 'Save failed!',
                            type: 'red',
                        });
                    }
                },
                error: function (er) {
                    console.log(er);
                }
            });
        } catch (e) {
            console.log(e);
        }
    }

    function fetchgrid(data){
        var columns = [
                     {
                        title: "Select",
                        width: 45,
                        locked: true,
                        headerAttributes: { style: "text-align:center;" },
                        attributes: { style: "text-align:center;" },
                        headerTemplate:
                            "<div style='text-align:center;'>" +
                            "<input type='checkbox' id='selectAll' /> " +
                            "<label for='selectAll' style='cursor:pointer;'>All</label>" +
                            "</div>",
                        template: "<input type='checkbox' class='client-checkbox' value='#= bnk_code #' />"
                     },
                     {
                field: "bnk_code",
                title: "Bank Code",
                locked: true,
                hidden: true,
            },
            {
                field: "bnk_name",
                title: "Bank Name",
                width: 150,
                locked: true
            },
               {
                      field: "status",
                      title: "Status",
                      width: 120,
                      locked: true
                  },
                   {
              title: "As per Bid",
              headerAttributes: { style: "text-align:center;font-weight:bold;" },
              columns: [
                  { field: "bid_appl_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;"} },
                  { field: "bid_quantity", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;"} },
                  { field: "bid_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;"} }
              ]              
          },
                  {
              title: "As per Bank",
             headerAttributes: { style: "text-align:center;font-weight:bold;" },
              columns: [
                  { field: "bnk_appl_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;"} },
                  { field: "bnk_quantity", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;"} },
                  { field: "bank_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;"} }
              ]
          },        

          {
              title: "Diff.",
              headerAttributes: { style: "text-align:center;font-weight:bold;" },
              columns: [
                  { field: "diff_appl_count", title: "No.of Appl", width: 120, attributes:{style:"text-align:right;color:red;"} },
                  { field: "diff_quantity", title: "No.of Shares", width: 130, attributes:{style:"text-align:right;color:red;"} },
                  { field: "diff_amount", title: "Amount", width: 120, attributes:{style:"text-align:right;color:red;"} }
              ]
          }
                 ];
                 if ($("#banktList").data("kendoGrid")) {
                    $("#banktList").data("kendoGrid").destroy();
                    $("#banktList").empty();
                 }
                     $("#banktList").kendoGrid({
                     dataSource: {
                         data: data,
                         pageSize: 20
                     },
                     height: 410,
                     pageable: {
                         pageSizes: [10, 20, 30],
                         refresh: true
                     },
                     sortable: true,
                     filterable: true,
                     resizable: true,
                     columns: columns,
                      excel: {
                        fileName: "BidBank_Summary_Report.xlsx",
                        allPages: true,   
                        filterable: true
                       },
                     dataBound: function () {
                        var grid = this;
                        grid.tbody.find("tr").each(function () {
                            var dataItem = grid.dataItem(this);
                            if (selectedCodes.includes(dataItem.bnk_code)) {
                                $(this).find(".client-checkbox").prop("checked", true);
                            }
                        });
                     }
                 });
    }

    function exportSummary() {
        var grid = $("#banktList").data("kendoGrid");
        grid.saveAsExcel();
    }

        function exportdetailSummary() {

        if (selectedCodes.length === 0) {
            $.alert({
                title: 'IPO Web',
                content: "Please select at least one bank",
                type: 'red',
            });
            return;
        }
        var bank_code = selectedCodes.join(",");
        var offer_code = localStorage.getItem("selectedIPO");
        var url = '/BidBank/getdetailBankSummary'
            + '?offer_code=' + encodeURIComponent(offer_code)
            + '&bank_code=' + encodeURIComponent(bank_code);

        window.location.href = url;
    }
</script>