@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    var userName = Context.Session.GetString("user_name");
    var role_code = Context.Session.GetString("user_role");
    var userCode = Context.Session.GetString("user_code");
    var menuJson = Context.Session.GetString("UserMenus");
    var menus = new List<MenuModel>();

    if (!string.IsNullOrEmpty(menuJson))
    {
        menus = System.Text.Json.JsonSerializer.Deserialize<List<MenuModel>>(menuJson);
    }
    var currentPath = Context.Request.Path.Value.ToLower();
    var normalizedPath = currentPath.Trim('/').ToLower();
    var getBoaMenu = menus?.FirstOrDefault(x =>
        (x.menu_url ?? "")
            .Replace("../", "")
            .Trim('/')
            .ToLower() == "boa/boa"
    );
    var Boachecklist = getBoaMenu?.Boachecklist_perm;
}
<!DOCTYPE html>
<html>  
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Run Recon - Bid Vs Bank</title>
    <style>
        .fa-file-excel-o {
            color: #fff !important;
        }
        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
            background-color: #027ed1 !important;
            color: #fff !important;
        }

        .nav-tabs .nav-item .nav-link:not(.active) {
            background-color: #716969;
            color: #fff;
        }

        /* Alternate row color */
        #banktList .k-grid-content tr.k-alt td {
            background-color: #fff;
            color: #000;
        }

        /* Consistent borders */
        #banktList .k-grid-header th,
        #banktList .k-grid-content td {
            border-right: 1px solid #ddd;
        }

            /* Remove last border */
            #banktList .k-grid-header th:last-child,
            #banktList .k-grid-content td:last-child {
                border-right: none;
            }

        /* Fixed layout for alignment */
        #banktList .k-grid-header table,
        #banktList .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #banktList .k-grid-header th,
        #banktList .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Compact size */
        #banktList .k-grid-content td {
            padding: 3px 6px;
            font-size: 12px;
            line-height: 18px;
            background: #fff;
        }

        #banktList .k-grid-header th {
            padding: 4px 6px;
            font-size: 12px;
            line-height: 18px;
        }

        /* Compact row height */
        #banktList .k-grid-content tr {
            height: 26px;
        }

        #banktList .k-grid-header tr {
            height: 28px;
        }

        .k-grid td {
            padding: 2px 2px;
            font-size: 13px;
        }

        #banktList { 
            margin-top:-12px;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body" style="margin-top:5px;height: 556px;width: 103%;margin-left: -18px;">
                <div class="row" style="margin-top: -17px;">
                    <div class="col-sm-3">
                        <label class="form-label" for="ctype" data-field="ctype">IPO Name</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <input type="text" class="form-control" id="iponame" readonly />
                        <input type="text" class="form-control" id="ipocode" hidden />
                    </div>
                    <div id="categoryrow1" class="col-sm-2">
                        <label class="form-label" for="bank" data-field="bank"> Category</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <select id="category1" class="form-select">

                            <option selected value="bidprimary">Bid vs Bank</option>
                            <option value="bankprimary">Bank vs Bid</option>
                        </select>
                    </div>
                    <div id="categoryrow" class="col-sm-1">
                        <label class="form-label" for="bank" data-field="bank">Sub Category</label>&nbsp;<span style="font-size: 12px;color:red;font-weight: bold;">*</span>
                        <select id="category" class="form-select">
                            <option value="">- Select - </option>
                            <option value="All" selected>All</option>
                            <option value="ASBA">ASBA</option>
                            <option value="Non ASBA">Non ASBA</option>
                        </select>
                    </div>

                    <div class="col-sm-6">
                        <span>
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="runrecon()" style="padding: 3px 15px;margin-top:28px;">Run Recon</button>
                            &nbsp;
                            <button type="button" onclick="exportSummary()" class="btn btn-primary" id="btnGen" style="padding: 3px 19px;margin-top:28px;"><i class="fa fa-file-excel-o"></i> Summary </button>
                            &nbsp;
                            <button type="button" onclick="exportdetailSummary()" class="btn btn-primary" id="btnGensummary" style="padding: 3px 9px;margin-top:28px; white-space: nowrap;"><i class="fa fa-file-excel-o"></i> Matched Summary </button>
                            &nbsp;
                            <button type="button" onclick="exportdifferenceSummary()" class="btn btn-primary" id="btnGenDiffsummary" style="padding: 3px 10px;margin-top:28px; white-space: nowrap;"><i class="fa fa-file-excel-o"></i> Difference Summary </button>

                        </span>
                    </div>

                </div>
                <div class="row" style="margin-top:20px;">
                    <div class="col-sm-12">
                        <div id="banktList"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>
</html>
<script>
    var selectedCodes = [];
      $(document).ready(function () {
          var category = "All";
          getBidBank(category);
        $('#navhead').text('Bid Vs Bank');
        var ipoName = localStorage.getItem("selectedIPOText");
        var ipocode = localStorage.getItem("selectedIPO");
        $("#iponame").val(ipoName);
        $("#ipocode").val(ipocode); 
        var boaChecklist = '@Boachecklist';
        var getnormalizedPath = '@normalizedPath';
        if(boaChecklist == "Y") {
           updateboaVisit(getnormalizedPath);
        }
    });

        function runrecon() {
            // getBidBank(); 
            var offer_code = localStorage.getItem("selectedIPO");
            var category = $("#category").val();
            if (offer_code) {
                if (category == "") {
                        $.alert({
                            title: 'IPO Allotment',
                            content: 'Please select category',
                            type: 'red',
                        });
                        return;
                    }
               getBidBank(category);
            } else {
                $("#btnGensummary").hide();
                $("#btnGen").hide();
                $.alert({
                    title: 'IPO Allotment',
                    content: 'IPO Code not selected',
                    type: 'red',
                });
            }
    }

    $(document).on("click", "#selectAll", function () {
        var isChecked = this.checked;

        $(".client-checkbox").each(function () {
            $(this).prop("checked", isChecked);
        });
    });

     $(document).on("change", "#selectAll", function () {
        var grid = $("#banktList").data("kendoGrid");

        if (this.checked) {
            var allData = grid.dataSource.data();
            selectedCodes = allData.map(function (item) {
             return item.bnk_code;
            });
        } else {
            selectedCodes = [];
        }
        grid.tbody.find(".client-checkbox").prop("checked", this.checked);
    });

    $(document).on("change", ".client-checkbox", function () {
        var grid = $("#banktList").data("kendoGrid");
        var row = $(this).closest("tr");
        var dataItem = grid.dataItem(row);
        var code = dataItem.bnk_code;

        if ($(this).is(":checked")) {
            if (!selectedCodes.includes(code)) {
                selectedCodes.push(code);
            }
        } else {
            selectedCodes = selectedCodes.filter(x => x !== code);
        }

        console.log("Selected:", selectedCodes);
    });

    function getBidBank(category){
        var offer_code =  localStorage.getItem("selectedIPO");
         var recontype=$("#category1").val();
          try {
            customAjax({
                type: "GET",
                url: '@Url.Action("getBidBank", "BidBank")',
                data: {
                offer_code: offer_code,
                category: category ,
                 recontype:recontype
                },
                success: function (response) {
                    if (response && response.success) {
                      var data = JSON.parse(response.data);
                      fetchgrid(data);
                      if(data.length==0){
                        $("#btnGen").hide();
                        $("#btnGensummary").hide();
                      }
                      else{
                        $("#btnGen").show();
                        $("#btnGensummary").show();
                      }
                    }
                    else {
                        $("#btnGen").hide();
                        $("#btnGensummary").hide();
                        $.alert({
                            title: 'IPO Allotment',
                            content: 'Bid Bank listed failed!',
                            type: 'red',
                        });
                    }
                },
                error: function (er) {
                    $("#btnGen").hide();
                    $("#btnGensummary").hide();
                    console.log(er);
                }
            });
        } catch (e) {
            console.log(e);
        }
    }

   function fetchgrid(data) {

    var columns = [
        {
            title: "Select",
            width: 45,
            locked: true,
            headerAttributes: { style: "text-align:center;" },
            attributes: { style: "text-align:center;" },
            headerTemplate:
                "<div style='text-align:center;'>" +
                "<input type='checkbox' id='selectAll' /> " +
                "<label for='selectAll' style='cursor:pointer;'>All</label>" +
                "</div>",
            template: "<input type='checkbox' class='client-checkbox' value='#= bnk_code #' />"
        },
        {
            field: "bnk_code",
            title: "Bank Code",
            hidden: true,
            locked: true
        },
        {
            field: "bnk_name",
            title: "Bank Name",
            width: 250,
            locked: true
        },
        {
            field: "status",
            title: "Status",
            width: 120,
            locked: true,
            footerTemplate: "<div style='text-align:center;font-weight:bold;'>TOTAL</div>",
                footerAttributes: { style: "text-align:center;font-weight:bold;" }
        },
        {
            title: "As per Bid",
            headerAttributes: { style: "text-align:center;font-weight:bold;" },
            columns: [
                {
                    field: "bid_appl_count",
                    title: "No.of Appl",
                    width: 120,
                    attributes: { style: "text-align:right;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                },
                {
                    field: "bid_quantity",
                    title: "No.of Shares",
                    width: 130,
                    attributes: { style: "text-align:right;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                },
                {
                    field: "bid_amount",
                    title: "Amount",
                    width: 150,
                    attributes: { style: "text-align:right;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                }
            ]
        },
        {
            title: "As per Bank",
            headerAttributes: { style: "text-align:center;font-weight:bold;" },
            columns: [
                {
                    field: "bnk_appl_count",
                    title: "No.of Appl",
                    width: 120,
                    attributes: { style: "text-align:right;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                },
                {
                    field: "bnk_quantity",
                    title: "No.of Shares",
                    width: 130,
                    attributes: { style: "text-align:right;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                },
                {
                    field: "bank_amount",
                    title: "Amount",
                    width: 150,
                    attributes: { style: "text-align:right;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                }
            ]
        },
        {
            title: "Diff.",
            headerAttributes: { style: "text-align:center;font-weight:bold;" },
            columns: [
                {
                    field: "diff_appl_count",
                    title: "No.of Appl",
                    width: 120,
                    attributes: { style: "text-align:right;color:red;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                },
                {
                    field: "diff_quantity",
                    title: "No.of Shares",
                    width: 130,
                    attributes: { style: "text-align:right;color:red;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                },
                {
                    field: "diff_amount",
                    title: "Amount",
                    width: 150,
                    attributes: { style: "text-align:right;color:red;" },
                    footerTemplate: "<div style='text-align:right;font-weight:bold'>#= kendo.toString(sum,'n0') #</div>",
                    footerAttributes: { style: "text-align:right;font-weight:bold;" }
                }
            ]
        }
    ];

    if ($("#banktList").data("kendoGrid")) {
        $("#banktList").data("kendoGrid").destroy();
        $("#banktList").empty();
    }

    $("#banktList").kendoGrid({

        dataSource: {
            data: data,
            pageSize: 20,
            aggregate: [
                { field: "bid_appl_count", aggregate: "sum" },
                { field: "bid_quantity", aggregate: "sum" },
                { field: "bid_amount", aggregate: "sum" },

                { field: "bnk_appl_count", aggregate: "sum" },
                { field: "bnk_quantity", aggregate: "sum" },
                { field: "bank_amount", aggregate: "sum" },

                { field: "diff_appl_count", aggregate: "sum" },
                { field: "diff_quantity", aggregate: "sum" },
                { field: "diff_amount", aggregate: "sum" }
            ]
        },

        height: 410,

        pageable: {
            pageSizes: [10, 20, 30],
            refresh: true
        },

        sortable: true,
        filterable: true,
        resizable: true,
        columns: columns,

        excel: {
            fileName: "BidBank_Summary_Report.xlsx",
            allPages: true,
            filterable: true
        },

        excelExport: function (e) {

            var sheet = e.workbook.sheets[0];

            sheet.rows.forEach(function (row) {

                if (row.type === "footer") {

                    row.cells.forEach(function (cell) {

                        if (typeof cell.value === "string") {

                            // Remove HTML tags
                            cell.value = cell.value.replace(/<[^>]*>/g, "");

                            // Remove extra spaces/newlines
                            cell.value = $.trim(cell.value);
                        }

                        cell.bold = true;
                    });
                }
            });

        },

        dataBound: function () {

            var grid = this;

            grid.tbody.find("tr").each(function () {

                var dataItem = grid.dataItem(this);

                if (selectedCodes.includes(dataItem.bnk_code)) {
                    $(this).find(".client-checkbox").prop("checked", true);
                }

            });

        }

    });

}
    function exportSummary() {
        var grid = $("#banktList").data("kendoGrid");
        if (grid) {
            grid.saveAsExcel();
        }
    }

        function exportdetailSummary() {

        if (selectedCodes.length === 0) {
            $.alert({
                title: 'IPO Web',
                content: "Please select at least one bank",
                type: 'red',
            });
            return;
        }
        var bank_code = selectedCodes.join(",");
        var offer_code = localStorage.getItem("selectedIPO");
        var url = '/BidBank/getdetailBankSummary'
            + '?offer_code=' + encodeURIComponent(offer_code)
            + '&bank_code=' + encodeURIComponent(bank_code);

        window.location.href = url;
    }

    function exportdifferenceSummary(){
        var offer_code = localStorage.getItem("selectedIPO");
        var url = '/BidBank/getdetaildifferenceSummary'
            + '?offer_code=' + encodeURIComponent(offer_code)
            + '&user_code=' + encodeURIComponent('@userName');

        window.location.href = url;
    }

</script>