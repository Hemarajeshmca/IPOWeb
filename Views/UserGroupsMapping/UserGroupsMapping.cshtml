    function loadgrid() {
        $.ajax({
            url: '@Url.Action("UserGroups", "UserGroupsMapping")',
            type: "Post",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            data: {},
            success: function (result) {
                debugger
                var columns = [];
                var data = JSON.parse(result._data);           
                var i = 0;
                debugger;
                var entryIndex = "entries[" + i + "]";              
                columns.push({                  
                    title: 'Action',                 
                    template: '<img style="cursor:pointer;" src="../Assets/images/editicons.png" onclick="edit_(' + "'E'" + ')"> <img style="cursor:pointer;margin-left:10px" src="../Assets/images/viewicons.png" onclick="edit_(' + "'V'" + ')">',
                    editable: true,
                    width: '100px'
                });
                for (var key in data[0]) {
                    debugger;                
                        try {
                             if (key == "role_code") {
                                columns.push({
                                    field: entryIndex,
                                    title: "Role Code",
                                    type: 'string',
                                });
                            }
                            else if (key == "role_name") {
                                columns.push({
                                    field: entryIndex,
                                    title: "Role Name",
                                    type: 'string',                                  
                                });
                            }else if (key == "app_code") {
                                columns.push({
                                    field: entryIndex,
                                    title: "Application Code",
                                    type: 'string',
                                });
                            }else if (key == "app_name") {
                                columns.push({
                                    field: entryIndex,
                                    title: "Application Name",
                                    type: 'string',
                                });
                            } 
                            else if (key == "role_id") {
                                columns.push({
                                    field: entryIndex,
                                    title: key,
                                    type: 'number',
                                    hidden:true                                  
                                });
                            }
                        }
                        catch (e) {
                            columns.push({
                                field: entryIndex,
                                title: key,
                                type: 'string'
                            });
                        }

                    i = i + 1;
                    entryIndex = "entries[" + i + "]";
                }

                debugger;
                var rows = [];
                var data1 = JSON.parse(result._data);
                $.each(data1, function (i, e) {
                    var entryArray = [];
                    $.each(e, function (key, val) {                     
                            entryArray.push(val);
                    });
                    rows.push(kendo.observable({

                        entries: entryArray
                    }));                  
                });

                var viewModel = kendo.observable({
                    gridRows: rows
                });

                var configuration = {                   
                    editable: false,
                    sortable: true,
                    scrollable: false,                  
                    filterable: false,
                    pagable: false,
                    resizable: true,                   
                    selectable: "false",
                    columns: columns,                   
                    rows: viewModel
                };

                $("#example").remove();             
                $('#Maingrid').append('<div id="example" class="table-responsive text-nowrap" id="chk1"><table id="grid" data-bind="source: gridRows" class="table table-sm" style="width:100%;height:auto;line-height:1em;font-size:12px;border:1px solid #d9d1d1;"></table></div>');
                var timeEditGrid = $("#grid").kendoGrid(configuration).data("kendoGrid");
                kendo.bind($("#grid"), viewModel);
                var grid = $("#grid").data("kendoGrid");               
            },
            error: function (result) {
                $.alert({
                    title: ' ',
                    content: "Failed to fetch.!",
                    type: 'red',
                });
            }
        });
    }

    function edit_(sel) {
        debugger;
        $("#attach").show();       
       var grid = $("#grid").data("kendoGrid");
        model = grid.dataItem($(event.target).closest("tr"));
        var role_code = model.entries[1];
        var app_code = model.entries[3];
        var role_name = model.entries[2];
        var app_name = model.entries[4];
        $("#btn_submit").hide();
        $("#btn_update").show();
        $("#title").text("Update User Group");
        $("#hdn_role_id").val(role_code);
        $("#hdn_grpname").val(app_code);
        Edit(role_code,role_name,app_code,app_name,sel);
    }

     function Edit_old(role_code,role_name,app_code,app_name,sel) {
        window.location.href = '../UserGroupsMapping/RoleMapping?role_code=' + role_code + '&role_name=' + role_name  + '&app_code=' + app_code  + '&app_name=' + app_name  + '&mode_=' + sel;
    }
        function Edit(role_code, role_name, app_code, app_name, sel) {

        var form = $('<form>', {
            action: '../UserGroupsMapping/RoleMapping',
            method: 'POST'
        });

        form.append($('<input>', { type: 'hidden', name: 'role_code', value: role_code }));
        form.append($('<input>', { type: 'hidden', name: 'role_name', value: role_name }));
        form.append($('<input>', { type: 'hidden', name: 'app_code', value: app_code }));
        form.append($('<input>', { type: 'hidden', name: 'app_name', value: app_name }));
        form.append($('<input>', { type: 'hidden', name: 'mode_', value: sel }));

        $('body').append(form);
        form.submit();
    }

    function View(usergroup_gid) {
        modal.load('../UserGroupsMapping/TreeViewPartial?usergroup_gid=' + usergroup_gid);
        $("#hdn_title").val("View UserGroups");
        modal.show();
        $("#btn_submit").show();
        return false;
    }

     function Close() {
        debugger;
        modal.hide();
        $("#btn_submit").hide();
        $("#btn_update").hide();
        $("#title").text("Create New User Group");
        $("#txtrole_name").prop("disabled", false);      
        setTimeout(function () {
            window.location.reload(0);
        }, 0);
    }

</script>

<script>
    function load_application()
    {
         $.ajax({
             type: "GET",
             url: '../UserGroupsMapping/Application_List',
             dataType: 'json',
             success: function (response) {

                 if (response.authExpired) {
                     $.alert({
                         title: 'Unauthorized',
                         content: response.message,
                         type: 'red',
                         buttons: {
                             ok: function () {
                                 window.location.href = '../login/logout';
                             }
                         }
                     });
                     return;
                 }

                 $("#app_list").empty()
                     .append('<option value="">Select</option>');

                 $.each(response, function (index, item) {
                     $("#app_list").append(
                         $('<option>', {
                              value: item.app_code,
                             text: item.app_name
                         })
                     );
                 });
             },
             error: function (er) {
                 console.log(er);
                   $.alert({
                    title: ' ',
                    content: "Error loading Applications!",
                    type: 'red',
                });
                
             }
         });
     }
</script>