@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";    
}
<!DOCTYPE html>
<html>   
<head>    
    <meta name="viewport" content="width=device-width" />
    <title>Role Management</title>    
    <style>
        #Maingrid .k-grid-content tr.k-alt td {
            background-color: #5997bb !important;
            color: #ffffff;
        }

        /* Normal rows – White */
        /* #dividendGrid .k-grid-content tr td {
                                background-color: #ffffff;
                            }      */

        /* Cell borders */
        #Maingrid td {
            border: 1px solid #cfd8dc;
        }

        /* Compact row height */
        #Maingrid .k-grid-content td {
            padding-top: 4px;
            padding-bottom: 4px;
        }

        /* Fixed layout */
        #Maingrid .k-grid-header table,
        #Maingrid .k-grid-content table {
            table-layout: fixed;
            width: 100%;
        }

        /* Prevent wrapping */
        #Maingrid .k-grid-header th,
        #Maingrid .k-grid-content td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #Maingrid .k-grid-content td {
            padding-top: 4px;
            padding-bottom: 4px;
            line-height: 18px;
            font-size: 13px;
            color: #000;
        }

        #Maingrid .k-grid-header th {
            padding-top: 4px;
            padding-bottom: 4px;
            line-height: 18px;
            font-size: 13px;
        }

        #attach .modal-dialog {
            max-width: 80%;
        }

        #attach .modal-content {
            height: 41vh;
        }

        #attach .modal-body {
            overflow-y: auto;
        }
    </style>
</head>

<body class="hold-transition skin-blue sidebar-mini fixed">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card-body">
                <form id="formAccountSettings" method="POST" onsubmit="return false">
                    <div class="row">
                        <div class="col-sm-12">
                            <button type="button" class="btn btn-sm btn-info me-2" data-bs-toggle="modal" data-bs-target="#attach" style="background: #1061b1;border-color: #1061b1;margin-top:-27px;" id=" btn_new">Add</button>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div id="Maingrid" class="col-md-9" style="margin:auto;height:auto;top:10px;width:100%;overflow:hidden">                         
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-8">
                            <div class="row">
                                <div class="col-sm-4">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                        </div>
                    </div>
                </form>
             </div>
        </div>
    </div>


    <div class="modal fade" id="attach" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                <div class="modal-body">

                    <!-- Header -->
                    <div class="text-center mb-3">
                        <h5 style="color:#1a9950; font-weight:600;">Add Role</h5>
                    </div>

                    <hr />

                    <!-- All inputs in one row -->
                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">
                            <label class="form-label">Role Code</label>
                            <input type="text" id="txtrole_code" class="form-control">
                            <input type="hidden" id="hdn_role_id">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Role Name</label>
                            <input type="text" id="txtrole_name" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Application</label>
                            <select id="app_list" class="form-select">
                                <option value="">Select</option>
                            </select>
                            <span id="queryErrorUserrole"
                                  class="text-danger small"
                                  size="3"
                                  style="overflow-y:auto;"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select id="role_status" class="form-select">
                                <option value="">-- Select Status --</option>
                                <option value="Y">Active</option>
                                <option value="N">Inactive</option>
                            </select>
                            <span id="queryErrorUserstatus"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                </div>

                <!-- Buttons row (left aligned) -->
                <div class="modal-footer d-flex justify-content-end">
                    <button type="button"
                            class="btn btn-sm btn-primary"
                            id="btn_submit"
                            onclick="return CreateUserGroups(0)">
                        Save
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>


</body>

</html>

<script>
    $(document).ready(function () {
         $('#navhead').text('Role Management');
         loadgrid();
         load_application();
    });


        function CreateUserGroups(usergroup_id) {

        var role_id = $("#hdn_role_id").val() || "0";
        var role_code = $("#txtrole_code").val();
        var role_name = $("#txtrole_name").val();
        var app_code = $("#app_list").val();
        var role_status = $("#role_status").val();

        $.ajax({
            type: "POST",
            dataType: "json",
            url: '@Url.Action("CreateUserGroupsNew", "UserGroupsMapping")',
            data: {
                role_id: role_id,
                role_name: role_name,
                role_code: role_code,
                app_code: app_code,
                role_status: role_status
            },
            success: function (data) {
                if (data.authExpired) {
                    $.alert({
                        title: 'Unauthorized',
                        content: data.msg || 'Unauthorized User',
                        type: 'red',
                        buttons: {
                            ok: {
                                text: 'OK',
                                action: function () {
                                    window.location.href = '/login/logout';
                                }
                            }
                        }
                    });
                    return; // ⛔ stop further execution
                }
                $.alert({
                    title: 'STA Web',
                    content: data.msg,
                    type: data.result ? 'green' : 'red'
                });

                if (data.result) {
                    setTimeout(function () {
                        window.location.reload();
                    }, 2000);
                }
            },
            error: function () {
                alert("Something went wrong");
            }
        });
    }


