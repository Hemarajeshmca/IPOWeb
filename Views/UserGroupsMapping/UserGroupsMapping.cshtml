            url: '@Url.Action("CreateUserGroupsNew", "UserGroupsMapping")',            
            data: { 'usergroup_gid': role_id, 'usergroup_name': role_name, 'usergroup_code': ugrp_code, 'app_code': app_code, 'usrgrpstatus': role_status },
            success: function (data) {
                var message = data.msg;
                $.alert({
