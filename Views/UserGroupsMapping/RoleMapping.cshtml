                download_perm: displayedData[i].entries[8],
               // link_perm: displayedData[i].entries[9],
                mail_perm: displayedData[i].entries[10],
                //retreq_perm: displayedData[i].entries[11],
                approve_perm: displayedData[i].entries[11],
                backtomaker_perm: displayedData[i].entries[12],
                deny_flag: displayedData[i].entries[13],
                role_code: "@ViewBag.usergrp_gid"

            }
            modelArr.push(modelobj);
        }
        var displayedDataAsJSON = JSON.stringify(modelArr);
        //alert(displayedDataAsJSON);
        $.ajax({
            url: '@Url.Action("SaveUserRoleMap", "UserGroupsMapping")',
            type: "post",
            //data: { "jsondata_": JSON.stringify(jsondata_1) },
            data: displayedDataAsJSON,
            contentType: "application/json",
           // dataType: "json",
            success: function (result) {
                
                //alert(result);
                if (result == 1 || result == "1") {
