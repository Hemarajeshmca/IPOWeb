                    console.log("TYPE:", typeof result);
                    console.log("Table:", result.Table);
                    console.log("Length:", result.Table ? result.Table.length : "NO TABLE");


                    var data = result.Table;
                    var permissions = result.Table1 || [];

                    var allowedColumns = new Set(
                        permissions.map(p => p.permission_code)
                    );

                    console.log("Allowed Columns:", allowedColumns);


                    if (!Array.isArray(data)) {
                        data = Object.values(data); // Convert object with numeric keys to array
                    }

