                        $("#Maingrid").data("kendoGrid").destroy();
                        $("#Maingrid").empty();
                    }
                    console.log("Before grid creation");
                        $("#Maingrid").kendoGrid({
                        height: 400,
                        dataSource: {
                            data: data,
                            schema: { model: { id: "menu_code" } }
                        },
                        sortable: true,
                       // filterable: true,
                        filterable: {
                            multi: true,
                            search: true
                        },
