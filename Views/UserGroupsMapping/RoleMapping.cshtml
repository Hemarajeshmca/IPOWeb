                dataType: "json",
                data: {
                    role_code: role_code,
                    app_code: app_code
                },
                success: function (result) {
                    if (result.authExpired) {
                         $.alert({
                             title: 'Unauthorized',
                             content: result.message,
                             type: 'red',
                             buttons: {
                                 ok: function () {
                                     window.location.href = '../login/logout';
                                 }
                             }
                         });
                         return;
                     }
