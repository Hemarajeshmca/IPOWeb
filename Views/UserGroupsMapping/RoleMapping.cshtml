        $(document).on("change", ".permCheckbox", function () {

        var grid = $("#Maingrid").data("kendoGrid");
        var row = $(this).closest("tr");
        var dataItem = grid.dataItem(row);

        var field = $(this).data("field");
        var isChecked = this.checked;

        if (field === "Deny" && isChecked) {

            dataItem.set("Add", "N");
            dataItem.set("Modify", "N");
            dataItem.set("Delete", "N");
            dataItem.set("View", "N");
            dataItem.set("Download", "N");
            dataItem.set("Mail", "N");
            dataItem.set("Approve", "N");
            dataItem.set("Boachecklist", "N");
            dataItem.set("Deny", "Y");

        } else {

            dataItem.set(field, isChecked ? "Y" : "N");

            var hasPermission =
                dataItem.Add === "Y" ||
                dataItem.Modify === "Y" ||
                dataItem.Delete === "Y" ||
                dataItem.View === "Y" ||
                dataItem.Download === "Y" ||
                dataItem.Mail === "Y" ||
                dataItem.Approve === "Y" ||
                dataItem.Boachecklist === "Y";

            dataItem.set("Deny", hasPermission ? "N" : "Y");
        }

        grid.refresh();
    });

    $("#saverole").click(function () {
        var dataToSave = getGridDataToSave();

        if (dataToSave.length === 0) {
             $.alert({
                    title: ' ',
                    content: "No permissions selected to save!",
                    type: 'red',
                }); 
            return;
        }

        $.ajax({
            url: '@Url.Action("SaveRolePermissions", "UserGroupsMapping")',
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(dataToSave),
            success: function (result) {
                if (result.authExpired) {
                     $.alert({
                         title: 'Unauthorized',
                         content: response.message,
                         type: 'red',
                         buttons: {
                             ok: function () {
                                 window.location.href = '../login/logout';
                             }
                         }
                     });
                     return;
                 }
                if (result.status) {
                    $.alert({
                        title: 'STA Web',
                        content: "Permissions saved successfully!",
                        type: 'green'
                    }); 
                        setTimeout(function () {
                            window.location.href='../UserGroupsMapping/UserGroupsMapping'
                        }, 2000); 
                } else {
                    $.alert({
                        title: 'STA Web',
                        content: result.message,
                        type: 'red'
                    }); 
                }
            },
            error: function (err) {
                alert("Failed to save permissions.");
            }
        });
    });
    function getGridDataToSave() {
        var grid = $("#Maingrid").data("kendoGrid");
        var data = grid.dataSource.data(); // All rows
        var saveData = [];

        data.forEach(function (item) {
            // If at least one permission is Y and Deny is not the only one
            if (
                        (item.Add === "Y" || item.Modify === "Y"|| item.Delete === "Y" || item.View === "Y" ||
                 item.Download === "Y" || item.Mail === "Y" ||
                             item.Approve === "Y" ||
                                 item.Boachecklist === "Y"  ) &&
                            // item.RetReq === "Y" || item.Link === "Y" ) &&
                item.Deny !== "Y"
            ) {
                saveData.push({
                    menu_code: item.menu_code,
                    Add: item.Add,
                    Modify: item.Modify,
                    Delete: item.Delete,
                    View: item.View,
                    Download: item.Download,
                  //  Link: item.Link,
                    Mail: item.Mail,
                    // RetReq: item.RetReq,
                    Approve: item.Approve,
                    Boachecklist: item.Boachecklist,
                    role_code: "@ViewBag.role_code",
                    app_code: "@ViewBag.app_code"
                });
            }
        });

        return saveData;
    }

    function save_rollmap_old() {        
