      function loadgrid_() {

            var role_code = "@ViewBag.role_code";
            var app_code = "@ViewBag.app_code";
            var modeFlag = "@ViewBag.mode_flag";

            $.ajax({
                url: '@Url.Action("RoleMappingData_", "UserGroupsMapping")',
