         function checkboxColumn(fieldName,displayname, modeFlag,allowedColumns) {
            var ss=fieldName;
            var dd=modeFlag;
            var columnExists = allowedColumns.has(fieldName);
            return {
                field: fieldName,
                title: displayname,
                width: 110,
                filterable: false,
                template: function (d) {
                    var value = d[fieldName];
                    var checked = value === "Y" ? "checked" : "";
                   var disabled = (modeFlag === "V" || !columnExists)
                    ? "disabled"
                    : "";
                    if(value=="Deny"){
                        disabled="";
                    }

                return '<input type="checkbox" ' +
                       'class="permCheckbox" ' +
                       'data-field="' + fieldName + '" ' +
                       checked + ' ' +
                       disabled + ' />';
                }
            };
        }

    function checkboxColumn_old(fieldName,displayname, modeFlag,allowedColumns) {
        var ss=fieldName;
        var dd=modeFlag;
        var columnExists = allowedColumns.has(fieldName);
        return {
