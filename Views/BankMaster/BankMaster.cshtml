function grid_load(){
            $("#grid").remove();
                $('#bankGrid').append('<div id="grid" style="margin-top: 6px;margin-left: 4px;"></div>');
            var data = {};
            data.in_user_code = "1";//sessionStorage.getItem("usrname");
            
                $.ajax({
                type: "POST",
                url: "../Bankmaster/getallbankmaster",
                dataType: "json",
                data: JSON.stringify({ in_user_code: data.in_user_code }),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                         if (data.authExpired) {
                                $.alert({
                                     title: 'Unauthorized',
                                    content: data.message || 'Unauthorized User',
                                    type: 'red',
                                    buttons: {
                                        ok: {
                                            text: 'OK',
                                            action: function () {
                                                window.location.href = '/login/logout';
                                            }
                                        }
                                    }
                                });
                                return;
                            }
                    if (data != null) {
                        grid_dataset_details(data);
                    } else {
                        grid_dataset_details([]);
                    }
                }
            });
    }

