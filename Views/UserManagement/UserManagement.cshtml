    function setRequirement(selector, isValid) {

        var element = $(selector);

        if (isValid) {

            element.removeClass("req-invalid");
            element.addClass("req-valid");

            element.find(".req-icon").text("✓");

        } else {

            element.removeClass("req-valid");
            element.addClass("req-invalid");

            element.find(".req-icon").text("○");
        }
    }

