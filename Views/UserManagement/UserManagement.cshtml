<script>
        // ===============================
    // Global Selected Roles Storage
    // ===============================
    let selectedRoles = new Set();
              let treeData = [];

    // Example preselected roles
    // selectedRoles.add("APPO|APPO_MKR");
    // selectedRoles.add("STA|STA_OPE");


    // ===============================
    // Initialize Window Once
    // ===============================
    $(document).ready(function () {

        $("#userrole_popup").kendoWindow({ 
            width: "350px",
            resizable: true,
            // height: "150px",
            title: "Role Mapping",
            modal: true,
            visible: false,
            closeOnEscape: true,
            actions: ["Close"]
        });

        $("#btnUserRole").click(function () {
            showDynamicTreeView();
        });

    });


    // ===============================
    // Load Tree Data
    // ===============================
    function showDynamicTreeView() {
            selectedRoles.clear();
            var existingTree = $("#userrole_tree").data("kendoTreeView");
            if (existingTree) {
                existingTree.dataSource.data([]); // clear data
                existingTree.destroy();
                $("#userrole_tree").empty();
            }
        $.ajax({
            url: '@Url.Action("UserRoleList", "RoleMaster")',
            type: "GET",
            dataType: "json",
            success: function (response) {
                 if (response.authExpired) {
                     $.alert({
                         title: 'Session Expired',
                         content: response.message,
                         type: 'red',
                         buttons: {
                             ok: function () {
                                 window.location.href = '../login/logout';
                             }
                         }
                     });
                     return;
                 }
                 
                var treeData = [];

                response.data.forEach(function (row) {

                    Object.keys(row).forEach(function (key) {

                        let cell = row[key];

                        if (!cell) return;

                        if (typeof cell === "object" && Object.keys(cell).length === 0)
                            return;

                        if (typeof cell === "string") {
                            try {
                                cell = JSON.parse(cell);
                            } catch {
                                return;
                            }
                        }

                        if (!cell.app_code) return;

                        // Find parent app
                        let parent = treeData.find(x => x.app_code === cell.app_code);

                        if (!parent) {
                            parent = {
                                text: cell.app_name,
                                app_code: cell.app_code,
                                expanded: false,
                                items: []
                            };
                            treeData.push(parent);
                        }

                        let roleKey = (cell.app_code + "|" + cell.role_code).toUpperCase();

                        parent.items.push({
                            text: cell.role_name,
                            app_code: cell.app_code,
                            role_code: cell.role_code,
                            checked: selectedRoles.has(roleKey)
                        });

                    });

                });

                console.log("Final treeData:", treeData);

                // Destroy old tree if exists
                var existingTree = $("#userrole_tree").data("kendoTreeView");
                if (existingTree) {
                    existingTree.destroy();
                    $("#userrole_tree").empty();
                }

                // Create TreeView ONLY ONCE
                $("#userrole_tree").kendoTreeView({
                    checkboxes: {
                        checkChildren: true
                    },
                    dataSource: treeData,
                    check: onTreeCheck,
                     dataBound: function () {
                        applyCheckedRoles($("#usercode").val());
                        this.expand(".k-item");
                    }
                }); 
                $("#userrole_popup").data("kendoWindow").center().open();
            },
            error: function (err) {
                console.log("AJAX Error:", err);
            }
        });
    }

        function applyCheckedRoles(userCode) {

        $.ajax({
            url: '@Url.Action("GetUserRole", "RoleMaster")',
            type: 'GET',
            data: { userCode: userCode },
            success: function (response) {

                if (!response.success) return;

                var tree = $("#userrole_tree").data("kendoTreeView");
                if (!tree) return;

                // 🔥 Reset global set
                selectedRoles.clear();

                response.data.forEach(x => {
                    let key = (x.app_code + "|" + x.role_code)
                        .toUpperCase()
                        .trim();

                    selectedRoles.add(key);
                });

                checkNodes(tree.dataSource.view());

                function checkNodes(nodes) {
                    for (var i = 0; i < nodes.length; i++) {

                        if (nodes[i].role_code) {

                            let key = (nodes[i].app_code + "|" + nodes[i].role_code)
                                .toUpperCase()
                                .trim();

                            if (selectedRoles.has(key)) {
                                nodes[i].set("checked", true);
                            }
                        }

                        if (nodes[i].hasChildren) {
                            checkNodes(nodes[i].children.view());
                        }
                    }
                }
            }
        });
    }

    // ===============================
    // Checkbox Change Event
    // ===============================
    function onTreeCheck(e) {

        var tree = $("#userrole_tree").data("kendoTreeView");
        var node = tree.dataItem(e.node);

        // Only handle child roles
        if (node.role_code) {

            let key = (node.app_code + "|" + node.role_code).toUpperCase();

            if (node.checked) {
                selectedRoles.add(key);
            } else {
                selectedRoles.delete(key);
            }

            console.log("Selected Roles:", Array.from(selectedRoles));
        }
    }

         // ==========================================
        // Save Roles
        // ==========================================

        function SaveRoles() {

        var tree = $("#userrole_tree").data("kendoTreeView");

        let selected = [];

        function getCheckedNodes(nodes) {

            for (var i = 0; i < nodes.length; i++) {

                if (nodes[i].checked && nodes[i].role_code) {

                    selected.push({
                        app_code: nodes[i].app_code,
                        role_code: nodes[i].role_code
                    });
                }

                if (nodes[i].hasChildren) {
                    getCheckedNodes(nodes[i].children.view());
                }
            }
        }

        getCheckedNodes(tree.dataSource.view());

        let payload = {
                user_code: $("#usercode").val(),
            roles: selected
        };

        $.ajax({
            url: '@Url.Action("SaveUserRoles", "RoleMaster")',
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {
                if (res.authExpired) {
                        $.alert({
                            title: 'Unauthorized',
                            content: res.message || 'Unauthorized User',
                            type: 'red',
                            buttons: {
                                ok: {
                                    text: 'OK',
                                    action: function () {
                                        window.location.href = '/login/logout';
                                    }
                                }
                            }
                        });
                        return;
                    }
                      $.alert({
                            title: 'STA Web',
                            content: "Role created successfully",
                            type: 'green'
                        });
                        $("#userrole_popup").data("kendoWindow").close();
                         setTimeout(() => window.location.href = "../UserManagement/UserManagement", 3000);
            },
            error: function () {
                alert("Error saving roles");
            }
        });
    }

       $("#eyeIcon").on("click", function () {

        var input = $("#userpwd");

        if (input.attr("type") === "password") {
            input.attr("type", "text");
            $(this).removeClass("fa-eye").addClass("fa-eye-slash");
        } else {
            input.attr("type", "password");
            $(this).removeClass("fa-eye-slash").addClass("fa-eye");
        }

    });
        function toggleUserLock(toggle) {

        var label = document.getElementById("lockLabel");

        if (toggle.checked) {
            label.innerText = "Locked";
        }
        else {
            label.innerText = "Unlocked";
        }
    }
</script>