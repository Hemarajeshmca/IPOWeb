    function loadUserRoles(userCode) {

        $.ajax({
            url: '@Url.Action("GetUserRole", "RoleMaster")',
            type: 'GET',
            data: { userCode: userCode },
            success: function (response) {

                if (!response.success) return;

                var tree = $("#userrole_tree").data("kendoTreeView");
                if (!tree) return;

                var data = response.data;

                // Create a Set for quick lookup
                let selectedSet = new Set();

                data.forEach(x => {
                    let key = (x.app_code + "|" + x.role_code).toUpperCase();
                    selectedSet.add(key);
                });

                // Uncheck everything first
                tree.dataSource.view().forEach(function clear(nodes) {
                    uncheckNodes(nodes);
                });

                function uncheckNodes(nodes) {
                    for (var i = 0; i < nodes.length; i++) {
                        nodes[i].set("checked", false);
                        if (nodes[i].hasChildren) {
                            uncheckNodes(nodes[i].children.view());
                        }
                    }
                }

                // Now check matching nodes
                function checkNodes(nodes) {
                    for (var i = 0; i < nodes.length; i++) {

                        if (nodes[i].role_code) {

                            let key = (nodes[i].app_code + "|" + nodes[i].role_code).toUpperCase();

                            if (selectedSet.has(key)) {
                                nodes[i].set("checked", true);
                            }
                        }

                        if (nodes[i].hasChildren) {
                            checkNodes(nodes[i].children.view());
                        }
                    }
                }

                checkNodes(tree.dataSource.view());
            }
        });
    }

