    function validatePassword() {

        var userpwd = $("#userpwd").val().trim();

        var minLength = parseInt(passwordConfig.password_min_len);
        var maxLength = parseInt(passwordConfig.password_max_len);

        // Empty password
        if (userpwd === "") {
            queryErrorpwd.textContent = "Enter Password";
            resetPasswordRequirements();
            return false;
        }else if(userpwd != ""){
            queryErrorpwd.textContent = "";
        }

        // Length
        var lengthValid =
            userpwd.length >= minLength &&
            userpwd.length <= maxLength;

        setRequirement("#reqLength", lengthValid);


        // Uppercase
        if (passwordConfig.pwd_require_uppercase === "Y") {

            var uppercaseValid = /[A-Z]/.test(userpwd);

            setRequirement("#reqUppercase", uppercaseValid);
        }


        // Lowercase
        if (passwordConfig.pwd_require_lowercase === "Y") {

            var lowercaseValid = /[a-z]/.test(userpwd);

            setRequirement("#reqLowercase", lowercaseValid);
        }


        // Number
        if (passwordConfig.pwd_require_number === "Y") {

            var numberValid = /[0-9]/.test(userpwd);

            setRequirement("#reqNumber", numberValid);
        }


        // Special character
        if (passwordConfig.pwd_require_special_char === "Y") {

            var specialValid = /[^A-Za-z0-9]/.test(userpwd);

            setRequirement("#reqSpecial", specialValid);
        }


        // Check whether all required rules are satisfied
        var isValid = lengthValid;

        if (passwordConfig.pwd_require_uppercase === "Y" &&
            !/[A-Z]/.test(userpwd)) {
            isValid = false;
        }

        if (passwordConfig.pwd_require_lowercase === "Y" &&
            !/[a-z]/.test(userpwd)) {
            isValid = false;
        }

        if (passwordConfig.pwd_require_number === "Y" &&
            !/[0-9]/.test(userpwd)) {
            isValid = false;
        }

        if (passwordConfig.pwd_require_special_char === "Y" &&
            !/[^A-Za-z0-9]/.test(userpwd)) {
            isValid = false;
        }

        return isValid;
    }
 
