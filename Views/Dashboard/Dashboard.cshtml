    //     console.log("Grid:", grid);
    //     grid.saveAsExcel();
    // }

        function exportClientList() {
        var grid = $("#grid").data("kendoGrid");

        var originalPageSize = grid.dataSource.pageSize();

        // Set page size to total records
        grid.dataSource.pageSize(grid.dataSource.total());

        // Wait for data to load, then export
        grid.one("dataBound", function () {
            grid.saveAsExcel();

            // Restore original page size after export
            grid.dataSource.pageSize(originalPageSize);
        });
    }
</script>
