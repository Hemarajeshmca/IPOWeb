<script type="text/javascript">
        $(document).ready(function () {
        var ipocode = localStorage.getItem("selectedIPO");
        $('#navhead').text('IPO Rule Master');
        rulemaster_load();
    });

    function rulemaster_load() 
    {

        var data = {};
        data.in_user_code = "1"; // sessionStorage.getItem("usrname");
        var ipocode = localStorage.getItem("selectedIPO");
        $.ajax({
            type: "POST",
            url: "../RuleMaster/GetAllRuleMaster?ipo_code=" + ipocode,
            dataType: "json",
            contentType: "application/json; charset=utf-8",

            success: function (response) {

                if (response.authExpired) {
                    $.alert({
                        title: "Unauthorized",
                        content: response.message,
                        type: "red",
                        buttons: {
                            ok: function () {
                                window.location.href = "/Login/Logout";
                            }
                        }
                    });
                    return;
                }

                    if (response.success) {
                        if (response.data) {
                            var ruleData = JSON.parse(response.data); 

                            var masterRules  = ruleData.Table;
                            var appliedRules  = ruleData.Table1;

                             
                             

                                //---------------
                                var masterRules = ruleData.Table || [];

                                var appliedRuleCodes = [];
                                       $("#txtRemarks").val(
                                            appliedRules.length > 0 ? (appliedRules[0].remarks || "") : ""
                                        );
                                if (appliedRules.length > 0 && appliedRules[0].rule_code) {
                                    appliedRuleCodes = appliedRules[0].rule_code.split(',').map(x => x.trim());
                                }
                                    $.each(masterRules, function (i, item) {

                                    item.enabled = true;
                                    item.status = "Applied";

                                    for (var j = 0; j < appliedRuleCodes.length; j++) {

                                        if (appliedRuleCodes[j] === item.rule_code) {   // Exact comparison
                                            item.status = "Applied";
                                            break;
                                        }
                                    }

                                });

                                

                                var appliedRules = [];
                                if (ruleData.Table1 && Array.isArray(ruleData.Table1)) {
                                    appliedRules = ruleData.Table1;
                                }
                                
                                $.each(masterRules, function (i, item) {

                                    var rule = appliedRules.find(function (x) {
                                        return x.rule_code === item.rule_code;
                                    });
                                        console.log(masterRules);
                                        console.log(appliedRules);
                                     
                                    item.enabled = true;
                                    item.status = "Applied";
                                    if (rule) {
                                       //  item.enabled = true;
                                         item.status = "Applied";       // Radio enabled
                                    } 
                                    
                                    if (item.rule_disable == "Y") {
                                            item.enabled = false;
                                            item.status = "Applied";
                                        }
                                });

                                rulemaster_grid(masterRules);
                        }
                        else {
                            rulemaster_grid([]);
                        }

                    }
                    else {

                        rulemaster_grid([]);

                    }
            },
            error: function (xhr) {
                console.log(xhr);
            }
        });

    }

    function rulemaster_grid(data) {

        if ($("#checklistGrid").data("kendoGrid")) {
            $("#checklistGrid").data("kendoGrid").destroy();
            $("#checklistGrid").empty();
        }

        $("#checklistGrid").kendoGrid({

            dataSource: {
                data: data,
                pageSize: 12,
                schema: {
                    model: {
                        fields: {
                            rule_code: { type: "string" },
                            rule_name: { type: "string" },
                            status: { type: "string" },
                            enabled: { type: "boolean" }
                        }
                    }
                }
            },
            pageable: true,
            sortable: true,
            filterable: true,
            scrollable: true,
            height: 300,
            columns: [

                {
                    field: "rule_code",
                    title: "Rule Code",
                    width: 120
                },

                {
                    field: "rule_name",
                    title: "Rule Name",
                    width: 350
                },

                {
                    title: "Enable",
                    width: 120,
                    attributes: {
                        style: "text-align:center;"
                    },
                    template:
                        "<input type='radio' " +
                        "class='status-radio' " +
                        "name='status_#=rule_code#' " +
                        "value='Applied' " +
                        "#= status=='Applied' ? 'checked' : '' # " +
                        "#= enabled ? '' : 'disabled' # />"
                },

                {
                    title: "Disable",
                    width: 120,
                    attributes: {
                        style: "text-align:center;"
                    },
                    template:
                        "<input type='radio' " +
                        "class='status-radio' " +
                        "name='status_#=rule_code#' " +
                        "value='NotApplied' " +
                        "#= status!='Applied' ? 'checked' : '' # " +
                        "#= enabled ? '' : 'disabled' # />"
                }

            ]

        });

    }


    function SaveAppliedRules() {

        var ipo_code = localStorage.getItem("selectedIPO");

        var ruleCodes = [];

        $("#checklistGrid tbody tr").each(function () {

            var grid = $("#checklistGrid").data("kendoGrid");
            var dataItem = grid.dataItem(this);

            var status = $(this)
                .find("input[type='radio']:checked")
                .val();

            if (status === "Applied") {
                ruleCodes.push(dataItem.rule_code);
            }
        });

        var rule_code = ruleCodes.join(",");

        console.log("IPO Code :", ipo_code);
        console.log("Rule Codes :", rule_code);

        var remarks=$("#txtRemarks").val();
        $.ajax({
            type: "POST",
            url: '@Url.Action("SaveAppliedRules", "RuleMaster")',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({
                ipo_code: ipo_code,
                rule_code: rule_code,
                remarks: remarks 
            }),
            success: function (response) {

                if (response.success) {
                    $.alert({
                        title: "Success",
                        content: "Rules Mapping saved successfully.",
                        type: "green"
                    });
                }
                else {
                    $.alert({
                        title: "Rules Mapping Error",
                        content: response.message,
                        type: "red"
                    });
                }
            }
        });

    }

     

    
</script>