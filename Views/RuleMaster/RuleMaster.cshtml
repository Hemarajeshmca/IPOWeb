<div class="modal-body" style="padding-top:2% !important;">
    <div id="checklistGrid">
    </div>
    <div class="mt-3">
        <label><b>Remarks</b></label>
        <textarea id="txtRemarks"
                  class="form-control"
                  rows="3"
                  placeholder="Enter Remarks"></textarea>
    </div>
    <br />
    <div style="text-align:center; ">
        <button type="button"
                id="btnsave"
                class="btn btn-success"
                onclick="SaveAppliedRules()">
            Save
        </button>
       @*  <button type="button"
                class="btn btn-secondary"
                data-dismiss="modal">
            Cancel
        </button> *@
    </div>
